---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_NAME, SITE_URL } from '../../data/site';

export const getStaticPaths = (async () => {
	const entries = await getCollection('guide', ({ data }) => !data.draft);

	return entries.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

// Navigation precedent / suivant dans l'ordre du guide
const all = (await getCollection('guide', ({ data }) => !data.draft)).sort(
	(a, b) => a.data.order - b.data.order,
);
const position = all.findIndex((item) => item.id === entry.id);
const previous = all[position - 1];
const next = all[position + 1];

const updated = entry.data.updated.toLocaleDateString('fr-FR', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});

const schema = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: entry.data.title,
	description: entry.data.description,
	dateModified: entry.data.updated.toISOString(),
	inLanguage: 'fr-FR',
	mainEntityOfPage: `${SITE_URL}/guide/${entry.id}/`,
	author: { '@type': 'Organization', name: SITE_NAME, url: SITE_URL },
	publisher: { '@type': 'Organization', name: SITE_NAME, url: SITE_URL },
	isPartOf: { '@type': 'CollectionPage', name: 'Guide GEO', url: `${SITE_URL}/guide/` },
};

const toc = headings.filter((heading) => heading.depth === 2);
---

<BaseLayout
	title={`${entry.data.title} | Guide GEO | Quoted`}
	description={entry.data.description}
	schema={schema}
>
	<article>
		<header class="intro">
			<div class="wrap wrap--narrow">
				<nav class="crumbs" aria-label="Fil d'Ariane">
					<a href="/guide/">Guide</a>
					<span aria-hidden="true">/</span>
					<span>{entry.data.shortTitle ?? entry.data.title}</span>
				</nav>

				<p class="kick">{entry.data.chapter}</p>
				<h1>{entry.data.title}</h1>
				<p class="lede">{entry.data.description}</p>
				<p class="date">Mis à jour le {updated}</p>
			</div>
		</header>

		<div class="wrap wrap--narrow body">
			{
				toc.length > 1 && (
					<nav class="toc" aria-label="Sommaire">
						<p class="toc__t">Sommaire</p>
						<ol>
							{toc.map((heading) => (
								<li>
									<a href={`#${heading.slug}`}>{heading.text}</a>
								</li>
							))}
						</ol>
					</nav>
				)
			}

			<div class="prose">
				<Content />
			</div>

			<nav class="pager" aria-label="Navigation dans le guide">
				{
					previous ? (
						<a class="pager__i" href={`/guide/${previous.id}/`}>
							<span class="pager__d">← Précédent</span>
							<span class="pager__t">{previous.data.shortTitle ?? previous.data.title}</span>
						</a>
					) : (
						<span />
					)
				}
				{
					next && (
						<a class="pager__i pager__i--n" href={`/guide/${next.id}/`}>
							<span class="pager__d">Suivant →</span>
							<span class="pager__t">{next.data.shortTitle ?? next.data.title}</span>
						</a>
					)
				}
			</nav>
		</div>

		<aside class="band band--dark">
			<div class="wrap wrap--narrow cta">
				<h2>Appliquer ça à votre marché ?</h2>
				<p>
					On relève ce que les moteurs répondent déjà sur vos sujets, qui ils citent, et
					ce qu'il faut faire en premier.
				</p>
				<a class="b b--go" href="/#contact">
					Parler de votre visibilité
					<span class="arw" aria-hidden="true">→</span>
				</a>
			</div>
		</aside>
	</article>
</BaseLayout>

<style>
	.intro {
		padding-block: clamp(2.25rem, 4.5vw, 3.5rem) clamp(1.75rem, 3.5vw, 2.75rem);
		background:
			radial-gradient(55% 70% at 90% 0%, var(--accent-wash), transparent 70%),
			var(--paper);
	}

	.crumbs {
		display: flex;
		gap: 0.5rem;
		font-size: var(--s--1);
		color: var(--ink-mute);
		margin-bottom: 1.5rem;
	}

	.crumbs a {
		color: var(--accent);
		font-weight: 600;
		text-decoration: none;
	}

	.crumbs a:hover {
		text-decoration: underline;
	}

	.intro h1 {
		font-size: var(--s-3);
		margin-bottom: 1.1rem;
	}

	.date {
		margin-top: 1.35rem;
		font-size: 0.8rem;
		color: var(--ink-mute);
	}

	.body {
		padding-bottom: clamp(3rem, 6vw, 5rem);
	}

	/* --- Sommaire --- */
	.toc {
		background: var(--surface);
		border-radius: var(--round);
		padding: 1.25rem 1.6rem;
		margin-bottom: clamp(2rem, 4vw, 3rem);
	}

	.toc__t {
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--ink-mute);
		margin-bottom: 0.75rem;
	}

	.toc ol {
		margin: 0;
		padding-left: 1.2rem;
		display: grid;
		gap: 0.4rem;
		font-size: var(--s--1);
	}

	.toc li::marker {
		color: var(--accent);
	}

	.toc a {
		color: var(--ink-soft);
		text-decoration: none;
	}

	.toc a:hover {
		color: var(--accent);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	/* --- Pagination --- */
	.pager {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
		margin-top: clamp(3rem, 6vw, 4.5rem);
		padding-top: 2rem;
		border-top: 1px solid var(--line);
	}

	.pager__i {
		display: grid;
		gap: 0.3rem;
		padding: 1.1rem 1.35rem;
		border-radius: var(--round-sm);
		background: var(--surface);
		text-decoration: none;
		transition: background-color 0.2s ease, transform 0.2s ease;
	}

	.pager__i:hover {
		background: var(--accent-wash);
		transform: translateY(-2px);
	}

	.pager__i--n {
		text-align: right;
	}

	.pager__d {
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.pager__t {
		font-family: var(--display);
		font-size: var(--s-1);
		font-weight: 600;
		letter-spacing: -0.025em;
		line-height: 1.2;
	}

	/* --- CTA --- */
	.cta {
		display: grid;
		gap: 1rem;
		justify-items: start;
	}

	.cta p {
		font-size: var(--s-1);
		line-height: 1.5;
		color: rgba(234, 240, 251, 0.75);
		max-width: 52ch;
	}

	.cta .b {
		margin-top: 0.5rem;
	}

	@media (max-width: 40rem) {
		.pager {
			grid-template-columns: 1fr;
		}

		.pager__i--n {
			text-align: left;
		}
	}
</style>
