---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_NAME, SITE_URL } from '../../data/site';

export const getStaticPaths = (async () => {
	const entries = await getCollection('guide', ({ data }) => !data.draft);

	return entries.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

// Navigation precedent / suivant dans l'ordre du guide
const all = (await getCollection('guide', ({ data }) => !data.draft)).sort(
	(a, b) => a.data.order - b.data.order,
);
const position = all.findIndex((item) => item.id === entry.id);
const previous = all[position - 1];
const next = all[position + 1];

const updated = entry.data.updated.toLocaleDateString('fr-FR', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});

const schema = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: entry.data.title,
	description: entry.data.description,
	dateModified: entry.data.updated.toISOString(),
	inLanguage: 'fr-FR',
	mainEntityOfPage: `${SITE_URL}/guide/${entry.id}/`,
	author: { '@type': 'Organization', name: SITE_NAME, url: SITE_URL },
	publisher: { '@type': 'Organization', name: SITE_NAME, url: SITE_URL },
	isPartOf: { '@type': 'CollectionPage', name: 'Guide GEO', url: `${SITE_URL}/guide/` },
};

// On ne garde que les h2 pour le sommaire
const toc = headings.filter((heading) => heading.depth === 2);
---

<BaseLayout
	title={`${entry.data.title} | Guide GEO | Quoted`}
	description={entry.data.description}
	schema={schema}
>
	<article class="article">
		<header class="section article__head">
			<div class="shell shell--narrow">
				<nav class="crumbs" aria-label="Fil d'Ariane">
					<a href="/guide/">Guide</a>
					<span aria-hidden="true">/</span>
					<span>{entry.data.shortTitle ?? entry.data.title}</span>
				</nav>

				<p class="article__chapter">{entry.data.chapter}</p>
				<h1>{entry.data.title}</h1>
				<p class="lede">{entry.data.description}</p>
				<p class="article__date">Mis à jour le {updated}</p>
			</div>
		</header>

		<div class="shell shell--narrow article__body">
			{
				toc.length > 1 && (
					<nav class="toc" aria-label="Sommaire">
						<p class="toc__title">Sommaire</p>
						<ol>
							{toc.map((heading) => (
								<li>
									<a href={`#${heading.slug}`}>{heading.text}</a>
								</li>
							))}
						</ol>
					</nav>
				)
			}

			<div class="prose">
				<Content />
			</div>

			<nav class="pager" aria-label="Navigation dans le guide">
				{
					previous ? (
						<a class="pager__item" href={`/guide/${previous.id}/`}>
							<span class="pager__dir">← Précédent</span>
							<span class="pager__title">{previous.data.shortTitle ?? previous.data.title}</span>
						</a>
					) : (
						<span />
					)
				}
				{
					next && (
						<a class="pager__item pager__item--next" href={`/guide/${next.id}/`}>
							<span class="pager__dir">Suivant →</span>
							<span class="pager__title">{next.data.shortTitle ?? next.data.title}</span>
						</a>
					)
				}
			</nav>
		</div>

		<aside class="section section--sunk article__cta">
			<div class="shell shell--narrow">
				<h2>Appliquer ça à votre marché&nbsp;?</h2>
				<p class="lede">
					On relève ce que les moteurs répondent déjà sur vos sujets, qui ils citent, et
					ce qu'il faut faire en premier.
				</p>
				<a class="btn btn--primary" href="/#contact">
					Demander un diagnostic
					<span class="btn__arrow" aria-hidden="true">→</span>
				</a>
			</div>
		</aside>
	</article>
</BaseLayout>

<style>
	.article__head {
		padding-bottom: clamp(2rem, 4vw, 3rem);
	}

	.crumbs {
		display: flex;
		gap: 0.5rem;
		font-size: var(--step--1);
		color: var(--ink-mute);
		margin-bottom: 1.75rem;
	}

	.crumbs a {
		color: var(--violet);
		text-decoration: none;
	}

	.crumbs a:hover {
		text-decoration: underline;
	}

	.article__chapter {
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--violet);
		margin-bottom: 0.9rem;
	}

	.article__head h1 {
		font-size: var(--step-4);
		margin-bottom: 1.25rem;
	}

	.article__date {
		margin-top: 1.5rem;
		font-size: 0.78rem;
		color: var(--ink-mute);
	}

	.article__body {
		padding-bottom: clamp(3rem, 6vw, 5rem);
	}

	/* --- Sommaire --- */
	.toc {
		border: 1px solid var(--line);
		border-radius: var(--radius-lg);
		background: var(--paper-raised);
		padding: 1.25rem 1.5rem;
		margin-bottom: clamp(2rem, 4vw, 3rem);
	}

	.toc__title {
		font-size: 0.66rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--ink-mute);
		margin-bottom: 0.75rem;
	}

	.toc ol {
		margin: 0;
		padding-left: 1.2rem;
		display: grid;
		gap: 0.4rem;
		font-size: var(--step--1);
	}

	.toc a {
		color: var(--ink-soft);
		text-decoration: none;
	}

	.toc a:hover {
		color: var(--violet);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	/* --- Pagination --- */
	.pager {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
		margin-top: clamp(3rem, 6vw, 4.5rem);
		padding-top: 2rem;
		border-top: 1px solid var(--line);
	}

	.pager__item {
		display: grid;
		gap: 0.35rem;
		padding: 1.1rem 1.25rem;
		border: 1px solid var(--line);
		border-radius: var(--radius-lg);
		background: var(--paper-raised);
		text-decoration: none;
		transition: border-color 0.2s ease, transform 0.2s ease;
	}

	.pager__item:hover {
		border-color: var(--violet-edge);
		transform: translateY(-2px);
	}

	.pager__item--next {
		text-align: right;
	}

	.pager__dir {
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--violet);
	}

	.pager__title {
		font-size: var(--step-1);
		font-weight: 700;
		letter-spacing: -0.025em;
		line-height: 1.2;
	}

	.article__cta h2 {
		font-size: var(--step-3);
		margin-bottom: 1rem;
	}

	.article__cta .btn {
		margin-top: 1.5rem;
	}

	@media (max-width: 40rem) {
		.pager {
			grid-template-columns: 1fr;
		}

		.pager__item--next {
			text-align: left;
		}
	}
</style>

<style is:global>
	/* --- Corps d'article rendu depuis le Markdown --- */
	.prose {
		font-size: 1.05rem;
		line-height: 1.75;
		color: var(--ink-soft);
	}

	.prose > * + * {
		margin-top: 1.25rem;
	}

	.prose h2 {
		font-size: var(--step-3);
		color: var(--ink);
		margin-top: 3rem;
		padding-top: 1.75rem;
		border-top: 1px solid var(--line);
		scroll-margin-top: 6rem;
	}

	.prose h3 {
		font-size: var(--step-1);
		color: var(--ink);
		margin-top: 2.25rem;
		scroll-margin-top: 6rem;
	}

	.prose strong {
		color: var(--ink);
		font-weight: 600;
	}

	.prose a {
		color: var(--violet-deep);
		text-decoration: underline;
		text-underline-offset: 3px;
		text-decoration-thickness: 1px;
		text-decoration-color: var(--violet-edge);
		transition: text-decoration-color 0.18s ease;
	}

	.prose a:hover {
		text-decoration-color: var(--violet);
	}

	.prose ul,
	.prose ol {
		padding-left: 1.35rem;
		display: grid;
		gap: 0.6rem;
	}

	.prose li::marker {
		color: var(--violet);
	}

	.prose blockquote {
		margin-inline: 0;
		padding: 0.85rem 0 0.85rem 1.35rem;
		border-left: 3px solid var(--violet);
		background: var(--violet-wash);
		border-radius: 0 var(--radius) var(--radius) 0;
		font-size: var(--step-1);
		font-weight: 600;
		line-height: 1.45;
		letter-spacing: -0.015em;
		color: var(--ink);
	}

	.prose blockquote p {
		margin: 0;
	}

	.prose code {
		font-family: ui-monospace, 'SFMono-Regular', 'Cascadia Code', monospace;
		font-size: 0.88em;
		background: var(--paper-sunk);
		border: 1px solid var(--line);
		border-radius: 3px;
		padding: 0.1em 0.35em;
	}

	.prose hr {
		border: 0;
		border-top: 1px solid var(--line);
		margin-block: 2.5rem;
	}
</style>
