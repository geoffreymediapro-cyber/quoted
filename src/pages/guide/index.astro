---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_URL } from '../../data/site';

const entries = (await getCollection('guide', ({ data }) => !data.draft)).sort(
	(a, b) => a.data.order - b.data.order,
);

// Regroupement par chapitre, dans l'ordre d'apparition
const chapters = entries.reduce<Map<string, typeof entries>>((acc, entry) => {
	const list = acc.get(entry.data.chapter) ?? [];
	list.push(entry);
	acc.set(entry.data.chapter, list);
	return acc;
}, new Map());

const schema = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: 'Guide GEO',
	url: `${SITE_URL}/guide/`,
	description:
		"Guide pratique du Generative Engine Optimization : comprendre, appliquer et mesurer la visibilité d'une marque dans les réponses générées par l'IA.",
};
---

<BaseLayout
	title="Guide GEO : comprendre, appliquer et mesurer | Quoted"
	description="Guide pratique du Generative Engine Optimization : ce que c'est, comment se faire citer par ChatGPT, Perplexity et Gemini, et comment mesurer sa visibilité sérieusement."
	schema={schema}
>
	<section class="section head">
		<div class="shell">
			<p class="eyebrow" data-num="Guide">GEO</p>
			<h1>Le guide.</h1>
			<p class="lede">
				La méthode que nous appliquons en mission, écrite en clair. Pas de teasing, pas
				de livre blanc à télécharger contre votre adresse e-mail&nbsp;: si vous voulez
				l'appliquer vous-même, tout est là.
			</p>
		</div>
	</section>

	<section class="section section--sunk">
		<div class="shell chapters">
			{
				[...chapters.entries()].map(([chapter, items]) => (
					<div class="chapter reveal">
						<h2 class="chapter__name">{chapter}</h2>
						<ul class="chapter__list">
							{items.map((entry) => (
								<li>
									<a href={`/guide/${entry.id}/`}>
										<h3>{entry.data.title}</h3>
										<p>{entry.data.description}</p>
										<span class="chapter__more">
											Lire <span aria-hidden="true">→</span>
										</span>
									</a>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</section>

	<section class="section">
		<div class="shell">
			<div class="closing">
				<h2>Vous préférez qu'on s'en charge&nbsp;?</h2>
				<p class="lede">
					On applique tout ce qui précède à votre marché, et on en sort une feuille de
					route priorisée.
				</p>
				<a class="btn btn--primary" href="/#expertise">
					Ce qu'on fait
					<span class="btn__arrow" aria-hidden="true">→</span>
				</a>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.head {
		padding-bottom: clamp(2.5rem, 5vw, 4rem);
	}

	.head h1 {
		font-size: var(--step-5);
		margin-block: 1.25rem 1.5rem;
	}

	.chapters {
		display: grid;
		gap: clamp(2.5rem, 5vw, 4rem);
	}

	.chapter {
		display: grid;
		grid-template-columns: minmax(8rem, 14rem) minmax(0, 1fr);
		gap: clamp(1.5rem, 4vw, 3rem);
		align-items: start;
	}

	.chapter__name {
		font-family: var(--sans);
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--violet);
		padding-top: 0.5rem;
	}

	.chapter__list {
		list-style: none;
		padding: 0;
		display: grid;
		gap: 1rem;
	}

	.chapter__list a {
		display: block;
		background: var(--paper-raised);
		border: 1px solid var(--line);
		border-radius: var(--radius-lg);
		padding: clamp(1.25rem, 2.5vw, 1.85rem);
		text-decoration: none;
		transition:
			border-color 0.22s ease,
			transform 0.22s cubic-bezier(0.2, 0.8, 0.3, 1),
			box-shadow 0.22s ease;
	}

	.chapter__list a:hover {
		border-color: var(--violet-edge);
		transform: translateY(-3px);
		box-shadow: var(--shadow-card);
	}

	.chapter__list h3 {
		font-size: var(--step-2);
		margin-bottom: 0.6rem;
	}

	.chapter__list p {
		font-size: var(--step--1);
		line-height: 1.6;
		color: var(--ink-soft);
		max-width: 62ch;
		margin-bottom: 1rem;
	}

	.chapter__more {
		font-size: var(--step--1);
		font-weight: 600;
		color: var(--violet);
	}

	.closing {
		text-align: center;
		display: grid;
		justify-items: center;
		gap: 1.25rem;
	}

	.closing .lede {
		max-width: 44ch;
	}

	@media (max-width: 48rem) {
		.chapter {
			grid-template-columns: 1fr;
			gap: 1rem;
		}
	}
</style>
