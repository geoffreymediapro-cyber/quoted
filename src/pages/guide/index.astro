---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_URL } from '../../data/site';

const entries = (await getCollection('guide', ({ data }) => !data.draft)).sort(
	(a, b) => a.data.order - b.data.order,
);

// Regroupement par chapitre, dans l'ordre d'apparition
const chapters = entries.reduce<Map<string, typeof entries>>((acc, entry) => {
	const list = acc.get(entry.data.chapter) ?? [];
	list.push(entry);
	acc.set(entry.data.chapter, list);
	return acc;
}, new Map());

const schema = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: 'Guide GEO',
	url: `${SITE_URL}/guide/`,
	description:
		"Guide pratique du Generative Engine Optimization : comprendre, appliquer et mesurer la visibilité d'une marque dans les réponses générées par l'IA.",
};
---

<BaseLayout
	title="Guide GEO : comprendre, appliquer et mesurer | Quoted"
	description="Guide pratique du Generative Engine Optimization : ce que c'est, comment se faire citer par ChatGPT, Perplexity et Gemini, et comment mesurer sa visibilité sérieusement."
	schema={schema}
>
	<section class="intro">
		<div class="wrap">
			<p class="kick">Guide GEO</p>
			<h1>Le guide.</h1>
			<p class="lede">
				La méthode que nous appliquons en mission, écrite en clair. Pas de teasing, pas
				de livre blanc à télécharger contre votre adresse e-mail : si vous voulez
				l'appliquer vous-même, tout est là.
			</p>
		</div>
	</section>

	<section class="band band--soft">
		<div class="wrap chapters">
			{
				[...chapters.entries()].map(([chapter, items]) => (
					<div class="chapter obs">
						<h2 class="chapter__name">{chapter}</h2>
						<ul class="chapter__list">
							{items.map((entry) => (
								<li>
									<a href={`/guide/${entry.id}/`}>
										<h3>{entry.data.title}</h3>
										<p>{entry.data.description}</p>
										<span class="chapter__go">
											Lire <span class="arw" aria-hidden="true">→</span>
										</span>
									</a>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</section>

	<section class="band">
		<div class="wrap closing obs">
			<h2>Vous préférez qu'on s'en charge ?</h2>
			<p class="lede">
				On applique tout ce qui précède à votre marché, et on en sort une feuille de
				route priorisée.
			</p>
			<a class="b b--go" href="/#expertises">
				Nos expertises
				<span class="arw" aria-hidden="true">→</span>
			</a>
		</div>
	</section>
</BaseLayout>

<style>
	.intro {
		padding-block: clamp(2.5rem, 5vw, 4.5rem) clamp(2rem, 4vw, 3.5rem);
		background:
			radial-gradient(55% 70% at 85% 0%, var(--accent-wash), transparent 70%),
			var(--paper);
	}

	.intro h1 {
		margin-bottom: 1.35rem;
	}

	.chapters {
		display: grid;
		gap: clamp(2.5rem, 5vw, 4rem);
	}

	.chapter {
		display: grid;
		grid-template-columns: minmax(8rem, 13rem) minmax(0, 1fr);
		gap: clamp(1.25rem, 3.5vw, 2.5rem);
		align-items: start;
	}

	.chapter__name {
		font-family: var(--body);
		font-size: 0.74rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--accent);
		padding-top: 0.6rem;
	}

	.chapter__list {
		list-style: none;
		padding: 0;
		display: grid;
		gap: 1rem;
	}

	.chapter__list a {
		display: grid;
		gap: 0.6rem;
		background: var(--paper);
		border: 1px solid var(--line);
		border-radius: var(--round);
		padding: clamp(1.25rem, 2.5vw, 1.85rem);
		text-decoration: none;
		transition:
			border-color 0.2s ease,
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}

	.chapter__list a:hover {
		border-color: transparent;
		transform: translateY(-3px);
		box-shadow: var(--shadow);
	}

	.chapter__list p {
		font-size: var(--s--1);
		line-height: 1.6;
		color: var(--ink-soft);
		max-width: 62ch;
	}

	.chapter__go {
		font-family: var(--display);
		font-weight: 600;
		color: var(--accent-deep);
	}

	.closing {
		display: grid;
		justify-items: center;
		text-align: center;
		gap: 1.25rem;
	}

	.closing .lede {
		max-width: 44ch;
	}

	@media (max-width: 48rem) {
		.chapter {
			grid-template-columns: 1fr;
			gap: 0.85rem;
		}
	}
</style>
