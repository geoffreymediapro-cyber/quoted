---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_URL } from '../../data/site';

const entries = (await getCollection('guide', ({ data }) => !data.draft)).sort(
	(a, b) => a.data.order - b.data.order,
);

// Regroupement par chapitre, dans l'ordre d'apparition
const chapters = entries.reduce<Map<string, typeof entries>>((acc, entry) => {
	const list = acc.get(entry.data.chapter) ?? [];
	list.push(entry);
	acc.set(entry.data.chapter, list);
	return acc;
}, new Map());

/** é → e avant le slug, sinon « Fondamentaux » passe mais pas un futur chapitre accentué. */
const slugifie = (s: string) =>
	s
		.normalize('NFD')
		.replace(/[̀-ͯ]/g, '')
		.toLowerCase()
		.replace(/[^a-z0-9]+/g, '-')
		.replace(/^-+|-+$/g, '');

const groupes = [...chapters.entries()].map(([nom, items]) => ({
	nom,
	slug: slugifie(nom),
	items,
}));

/**
 * Filtre en CSS pur : un bouton radio par chapitre, et une regle qui masque
 * les autres quand il est coche. Les chapitres naissent du contenu, les
 * regles sont donc generees ici plutot qu'ecrites a la main.
 *
 * ⚠️ C'est aussi la raison pour laquelle `.obs` est porte par le conteneur
 * et non par chaque chapitre : un bloc en `display: none` ne croise jamais
 * l'observateur, il n'obtient jamais `.seen`, et il resterait invisible une
 * fois demasque par le filtre.
 */
const filtreCss = groupes
	.map((g) => `.guide:has(#ch-${g.slug}:checked) .chapter:not(.ch--${g.slug}){display:none}`)
	.join('\n');

const schema = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: 'Guide GEO',
	url: `${SITE_URL}/guide/`,
	description:
		"Guide pratique du Generative Engine Optimization : comprendre, appliquer et mesurer la visibilité d'une marque dans les réponses générées par l'IA.",
};
---

<BaseLayout
	title="Guide GEO : comprendre, appliquer et mesurer | Quoted"
	description="Guide pratique du Generative Engine Optimization : ce que c'est, comment se faire citer par ChatGPT, Perplexity et Gemini, et comment mesurer sa visibilité sérieusement."
	schema={schema}
>
	<section class="intro">
		<div class="wrap">
			<p class="kick">Guide GEO</p>
			<h1>Le guide.</h1>
			<p class="lede">
				La méthode que nous appliquons en mission, écrite en clair. Pas de teasing, pas
				de livre blanc à télécharger contre votre adresse e-mail : si vous voulez
				l'appliquer vous-même, tout est là.
			</p>
		</div>
	</section>

	<section class="band band--soft">
		<div class="wrap guide obs">
			<fieldset class="filtre">
				<legend class="sr">Filtrer le guide par chapitre</legend>

				<input class="sr" type="radio" name="chapitre" id="ch-tout" checked />
				<label class="puce" for="ch-tout">
					Tout <span class="puce__n">{entries.length}</span>
				</label>

				{
					groupes.map((g) => (
						<>
							<input class="sr" type="radio" name="chapitre" id={`ch-${g.slug}`} />
							<label class="puce" for={`ch-${g.slug}`}>
								{g.nom} <span class="puce__n">{g.items.length}</span>
							</label>
						</>
					))
				}
			</fieldset>

			<div class="chapters">
				{
					groupes.map((g) => (
						<div class={`chapter ch--${g.slug}`}>
							<h2 class="chapter__name">{g.nom}</h2>
							<ul class="chapter__list">
								{g.items.map((entry) => (
									<li>
										<a href={`/guide/${entry.id}/`}>
											<h3>{entry.data.title}</h3>
											<p>{entry.data.description}</p>
											<span class="chapter__go">
												Lire <span class="arw" aria-hidden="true">→</span>
											</span>
										</a>
									</li>
								))}
							</ul>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="band">
		<div class="wrap closing obs">
			<h2>Vous préférez qu'on s'en charge ?</h2>
			<p class="lede">
				On applique tout ce qui précède à votre marché, et on en sort une feuille de
				route priorisée.
			</p>
			<a class="b b--go" href="/#expertises">
				Nos expertises
				<span class="arw" aria-hidden="true">→</span>
			</a>
		</div>
	</section>
</BaseLayout>

<style>
	.intro {
		padding-block: clamp(2.5rem, 5vw, 4.5rem) clamp(2rem, 4vw, 3.5rem);
		background:
			radial-gradient(55% 70% at 85% 0%, var(--accent-wash), transparent 70%),
			var(--paper);
	}

	.intro h1 {
		margin-bottom: 1.35rem;
	}

	.guide {
		display: grid;
		gap: clamp(2rem, 4vw, 3rem);
	}

	/* Des puces, pas un menu deroulant : les chapitres restent tous lisibles. */
	.filtre {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0;
		padding: 0 0 clamp(1.25rem, 2.5vw, 1.75rem);
		border: 0;
		border-bottom: 1px solid var(--line);
	}

	.puce {
		display: inline-flex;
		align-items: baseline;
		gap: 0.45rem;
		padding: 0.5rem 0.95rem;
		border: 1px solid var(--line-strong);
		border-radius: 999px;
		background: var(--paper);
		font-family: var(--display);
		font-size: var(--s--1);
		font-weight: 600;
		color: var(--ink-soft);
		cursor: pointer;
		user-select: none;
		transition:
			border-color 0.18s ease,
			background-color 0.18s ease,
			color 0.18s ease;
	}

	.puce:hover {
		border-color: var(--accent-line);
		color: var(--ink);
	}

	.puce__n {
		font-size: 0.72rem;
		font-variant-numeric: tabular-nums;
		color: var(--ink-mute);
	}

	input:checked + .puce {
		background: var(--accent);
		border-color: var(--accent);
		color: #fff;
	}

	input:checked + .puce .puce__n {
		color: rgb(255 255 255 / 0.7);
	}

	/* Le radio est masque, c'est donc la puce qui doit montrer le focus clavier. */
	input:focus-visible + .puce {
		outline: 2px solid var(--accent-deep);
		outline-offset: 2px;
	}

	.chapters {
		display: grid;
		gap: clamp(2.5rem, 5vw, 4rem);
	}

	.chapter {
		display: grid;
		grid-template-columns: minmax(8rem, 13rem) minmax(0, 1fr);
		gap: clamp(1.25rem, 3.5vw, 2.5rem);
		align-items: start;
	}

	.chapter__name {
		font-family: var(--body);
		font-size: 0.74rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--accent);
		padding-top: 0.6rem;
	}

	.chapter__list {
		list-style: none;
		padding: 0;
		display: grid;
		gap: 1rem;
	}

	.chapter__list a {
		display: grid;
		gap: 0.6rem;
		background: var(--paper);
		border: 1px solid var(--line);
		border-radius: var(--round);
		padding: clamp(1.25rem, 2.5vw, 1.85rem);
		text-decoration: none;
		transition:
			border-color 0.2s ease,
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}

	.chapter__list a:hover {
		border-color: transparent;
		transform: translateY(-3px);
		box-shadow: var(--shadow);
	}

	.chapter__list p {
		font-size: var(--s--1);
		line-height: 1.6;
		color: var(--ink-soft);
		max-width: 62ch;
	}

	.chapter__go {
		font-family: var(--display);
		font-weight: 600;
		color: var(--accent-deep);
	}

	.closing {
		display: grid;
		justify-items: center;
		text-align: center;
		gap: 1.25rem;
	}

	.closing .lede {
		max-width: 44ch;
	}

	@media (max-width: 48rem) {
		.chapter {
			grid-template-columns: 1fr;
			gap: 0.85rem;
		}
	}
</style>

{/* Regles du filtre, generees d'apres les chapitres reellement presents. */}
<style is:inline set:html={filtreCss}></style>
