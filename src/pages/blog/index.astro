---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_URL } from '../../data/site';

/**
 * Index du blog. Tant qu'aucun article n'est publie, la page reste en
 * noindex et sort du sitemap (filtre dans astro.config.mjs) : une page de
 * liste vide n'a rien a faire dans l'index. Le premier article publie
 * rallume l'entree de menu, le lien de pied de page et le sitemap.
 */

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const jour = (value: Date) =>
	value.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' });

const schema = {
	'@context': 'https://schema.org',
	'@type': 'Blog',
	name: 'Le blog de Quoted',
	url: `${SITE_URL}/blog/`,
	description:
		"Ce qu'on observe sur les moteurs de réponse : relevés, changements de comportement des modèles, et ce que ça change pour la visibilité d'une marque.",
};
---

<BaseLayout
	title="Le blog | Quoted"
	description="Ce qu'on observe sur les moteurs de réponse : relevés, changements de comportement des modèles, et ce que ça change pour la visibilité d'une marque."
	noindex={posts.length === 0}
	schema={schema}
>
	<section class="intro">
		<div class="wrap">
			<p class="kick">Le blog</p>
			<h1>Ce qu'on observe.</h1>
			<p class="lede">
				Le guide dit comment faire. Ici on écrit ce qu'on voit passer : des relevés, des
				changements de comportement des modèles, et ce que ça change concrètement.
			</p>
		</div>
	</section>

	<section class="band band--soft">
		<div class="wrap">
			{
				posts.length === 0 ? (
					<p class="vide">
						Rien de publié pour le moment. Le <a href="/guide/">guide</a> est en revanche
						complet et en accès libre.
					</p>
				) : (
					<ul class="posts">
						{posts.map((post, index) => (
							<li class="obs" style={`--d: ${index * 50}ms`}>
								<a href={`/blog/${post.id}/`}>
									<div class="post__meta">
										<span class="post__tag">{post.data.tag}</span>
										<time datetime={post.data.date.toISOString()}>{jour(post.data.date)}</time>
									</div>
									<div>
										<h2>{post.data.title}</h2>
										<p>{post.data.description}</p>
										<span class="post__go">
											Lire <span class="arw" aria-hidden="true">→</span>
										</span>
									</div>
								</a>
							</li>
						))}
					</ul>
				)
			}
		</div>
	</section>

	<section class="band">
		<div class="wrap closing obs">
			<h2>Savoir ce que l'IA dit de vous ?</h2>
			<p class="lede">
				On rejoue vos questions sur les moteurs et on vous renvoie ce qu'ils répondent,
				et qui ils citent.
			</p>
			<a class="b b--go" href="/scan/">
				Scanner ma visibilité IA
				<span class="arw" aria-hidden="true">→</span>
			</a>
		</div>
	</section>
</BaseLayout>

<style>
	.intro {
		padding-block: clamp(2.5rem, 5vw, 4.5rem) clamp(2rem, 4vw, 3.5rem);
		background:
			radial-gradient(55% 70% at 85% 0%, var(--accent-wash), transparent 70%),
			var(--paper);
	}

	.intro h1 {
		margin-bottom: 1.35rem;
	}

	.vide {
		font-size: var(--s-1);
		color: var(--ink-soft);
	}

	.vide a {
		color: var(--accent);
		font-weight: 600;
	}

	.posts {
		list-style: none;
		padding: 0;
		display: grid;
		gap: 1rem;
	}

	/* Date a gauche, article a droite : la colonne fixe aligne les titres. */
	.posts a {
		display: grid;
		grid-template-columns: minmax(8rem, 12rem) minmax(0, 1fr);
		gap: clamp(1rem, 3vw, 2.5rem);
		align-items: start;
		background: var(--paper);
		border: 1px solid var(--line);
		border-radius: var(--round);
		padding: clamp(1.25rem, 2.5vw, 1.85rem);
		text-decoration: none;
		transition:
			border-color 0.2s ease,
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}

	.posts a:hover {
		border-color: transparent;
		transform: translateY(-3px);
		box-shadow: var(--shadow);
	}

	.post__meta {
		display: grid;
		gap: 0.35rem;
		padding-top: 0.2rem;
	}

	.post__tag {
		font-family: var(--body);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.post__meta time {
		font-size: var(--s--1);
		color: var(--ink-mute);
	}

	.posts h2 {
		font-size: var(--s-1);
		text-transform: none;
		margin-bottom: 0.55rem;
	}

	.posts p {
		font-size: var(--s--1);
		line-height: 1.6;
		color: var(--ink-soft);
		max-width: 62ch;
		margin-bottom: 0.6rem;
	}

	.post__go {
		font-family: var(--display);
		font-weight: 600;
		color: var(--accent-deep);
	}

	.closing {
		display: grid;
		justify-items: center;
		text-align: center;
		gap: 1.25rem;
	}

	.closing .lede {
		max-width: 44ch;
	}

	@media (max-width: 48rem) {
		.posts a {
			grid-template-columns: 1fr;
			gap: 0.7rem;
		}

		.post__meta {
			display: flex;
			align-items: baseline;
			gap: 0.75rem;
			padding-top: 0;
		}
	}
</style>
