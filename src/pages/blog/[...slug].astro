---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_NAME, SITE_URL } from '../../data/site';

export const getStaticPaths = (async () => {
	const posts = await getCollection('blog', ({ data }) => !data.draft);

	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content, headings } = await render(post);

// Navigation chronologique, du plus recent au plus ancien.
const all = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const position = all.findIndex((item) => item.id === post.id);
const recent = all[position - 1];
const ancien = all[position + 1];

const jour = (value: Date) =>
	value.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' });

const schema = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: post.data.title,
	description: post.data.description,
	datePublished: post.data.date.toISOString(),
	...(post.data.updated && { dateModified: post.data.updated.toISOString() }),
	inLanguage: 'fr-FR',
	mainEntityOfPage: `${SITE_URL}/blog/${post.id}/`,
	author: { '@type': 'Organization', name: SITE_NAME, url: SITE_URL },
	publisher: { '@type': 'Organization', name: SITE_NAME, url: SITE_URL },
	isPartOf: { '@type': 'Blog', name: 'Le blog de Quoted', url: `${SITE_URL}/blog/` },
};

const toc = headings.filter((heading) => heading.depth === 2);
---

<BaseLayout
	title={`${post.data.title} | Quoted`}
	description={post.data.description}
	schema={schema}
>
	<article>
		<header class="intro">
			<div class="wrap wrap--narrow">
				<nav class="crumbs" aria-label="Fil d'Ariane">
					<a href="/blog/">Blog</a>
					<span aria-hidden="true">/</span>
					<span>{post.data.title}</span>
				</nav>

				<p class="kick">{post.data.tag}</p>
				<h1>{post.data.title}</h1>
				<p class="lede">{post.data.description}</p>
				<p class="date">
					Publié le <time datetime={post.data.date.toISOString()}>{jour(post.data.date)}</time>
					{
						post.data.updated && (
							<>
								{', mis à jour le '}
								<time datetime={post.data.updated.toISOString()}>{jour(post.data.updated)}</time>
							</>
						)
					}
				</p>
			</div>
		</header>

		<div class="wrap wrap--narrow body">
			{
				toc.length > 1 && (
					<nav class="toc" aria-label="Sommaire">
						<p class="toc__t">Sommaire</p>
						<ol>
							{toc.map((heading) => (
								<li>
									<a href={`#${heading.slug}`}>{heading.text}</a>
								</li>
							))}
						</ol>
					</nav>
				)
			}

			<div class="prose">
				<Content />
			</div>

			<nav class="pager" aria-label="Autres articles">
				{
					recent ? (
						<a class="pager__i" href={`/blog/${recent.id}/`}>
							<span class="pager__d">← Plus récent</span>
							<span class="pager__t">{recent.data.title}</span>
						</a>
					) : (
						<span />
					)
				}
				{
					ancien && (
						<a class="pager__i pager__i--n" href={`/blog/${ancien.id}/`}>
							<span class="pager__d">Plus ancien →</span>
							<span class="pager__t">{ancien.data.title}</span>
						</a>
					)
				}
			</nav>
		</div>

		<aside class="band band--dark">
			<div class="wrap wrap--narrow cta">
				<h2>Et sur votre marché, ça donne quoi ?</h2>
				<p>
					On relève ce que les moteurs répondent déjà sur vos sujets, qui ils citent, et
					ce qu'il faut faire en premier.
				</p>
				<a class="b b--go" href="/scan/">
					Scanner ma visibilité IA
					<span class="arw" aria-hidden="true">→</span>
				</a>
			</div>
		</aside>
	</article>
</BaseLayout>

<style>
	.intro {
		padding-block: clamp(2.25rem, 4.5vw, 3.5rem) clamp(1.75rem, 3.5vw, 2.75rem);
		background:
			radial-gradient(55% 70% at 90% 0%, var(--accent-wash), transparent 70%),
			var(--paper);
	}

	.crumbs {
		display: flex;
		gap: 0.5rem;
		font-size: var(--s--1);
		color: var(--ink-mute);
		margin-bottom: 1.5rem;
	}

	.crumbs a {
		color: var(--accent);
		font-weight: 600;
		text-decoration: none;
	}

	.crumbs a:hover {
		text-decoration: underline;
	}

	.intro h1 {
		font-size: var(--s-3);
		margin-bottom: 1.1rem;
	}

	.date {
		margin-top: 1.35rem;
		font-size: 0.8rem;
		color: var(--ink-mute);
	}

	.body {
		padding-bottom: clamp(3rem, 6vw, 5rem);
	}

	.toc {
		background: var(--surface);
		border-radius: var(--round);
		padding: 1.25rem 1.6rem;
		margin-bottom: clamp(2rem, 4vw, 3rem);
	}

	.toc__t {
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--ink-mute);
		margin-bottom: 0.75rem;
	}

	.toc ol {
		margin: 0;
		padding-left: 1.2rem;
		display: grid;
		gap: 0.4rem;
		font-size: var(--s--1);
	}

	.toc li::marker {
		color: var(--accent);
	}

	.toc a {
		color: var(--ink-soft);
		text-decoration: none;
	}

	.toc a:hover {
		color: var(--accent);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.pager {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
		margin-top: clamp(3rem, 6vw, 4.5rem);
		padding-top: 2rem;
		border-top: 1px solid var(--line);
	}

	.pager__i {
		display: grid;
		gap: 0.3rem;
		padding: 1.1rem 1.35rem;
		border-radius: var(--round-sm);
		background: var(--surface);
		text-decoration: none;
		transition:
			background-color 0.2s ease,
			transform 0.2s ease;
	}

	.pager__i:hover {
		background: var(--accent-wash);
		transform: translateY(-2px);
	}

	.pager__i--n {
		text-align: right;
	}

	.pager__d {
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.pager__t {
		font-family: var(--display);
		font-size: var(--s-1);
		font-weight: 600;
		letter-spacing: -0.025em;
		line-height: 1.2;
	}

	.cta {
		display: grid;
		gap: 1rem;
		justify-items: start;
	}

	.cta p {
		font-size: var(--s-1);
		line-height: 1.5;
		color: rgba(234, 240, 251, 0.75);
		max-width: 52ch;
	}

	.cta .b {
		margin-top: 0.5rem;
	}

	@media (max-width: 40rem) {
		.pager {
			grid-template-columns: 1fr;
		}

		.pager__i--n {
			text-align: left;
		}
	}
</style>
