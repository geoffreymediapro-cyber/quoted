---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { FORM_KEY, SITE_URL } from '../data/site';

/**
 * Page dediee au scan. Tant que FORM_KEY est vide, aucun envoi ne peut
 * aboutir : la page reste donc en noindex et le formulaire bascule sur un
 * mailto pre-rempli. Une fois la cle posee, la page devient indexable et
 * il faut retirer l'exclusion de /scan du sitemap dans astro.config.mjs.
 */

const contents = [
	'Cinq prompts de votre marché, rejoués sur cinq moteurs',
	'Ce qui ressort, et les sources citées à chaque fois',
	'Si votre marque apparaît, et à quelle place',
	'Les deux ou trois écarts les plus évidents',
];

const schema = {
	'@context': 'https://schema.org',
	'@type': 'ContactPage',
	name: 'Scan de visibilité IA',
	url: `${SITE_URL}/scan/`,
	description:
		"Demander un relevé gratuit de votre visibilité dans les réponses générées par ChatGPT, Perplexity, Gemini, Claude et les AI Overviews.",
};
---

<BaseLayout
	title="Scanner ma visibilité IA | Quoted"
	description="Un relevé gratuit de ce que ChatGPT, Perplexity, Gemini, Claude et les AI Overviews répondent sur vos sujets, et de qui ils citent. Réponse sous 48 h ouvrées."
	noindex={!FORM_KEY}
	schema={schema}
>
	<section class="band band--dark">
		<div class="wrap on-dark">
			<div class="top">
				<div>
					<p class="kick">Le scan</p>
					<h1>Voyons ce que l'IA <span class="hi">dit déjà</span> de vous</h1>
					<p class="lead">
						Décrivez votre situation en quelques champs. Nous rejouons vos questions sur
						les moteurs et nous vous renvoyons ce qu'ils répondent, et qui ils citent.
					</p>
				</div>

				<aside class="box">
					<p class="box__t">Ce que contient le scan</p>
					<ul class="ticks">
						{contents.map((item) => <li>{item}</li>)}
					</ul>
					<p class="box__n">
						Gratuit, sans engagement, et sans relance automatique derrière. Réponse sous
						48 h ouvrées. Ce n'est pas un audit complet : c'est un aperçu honnête pour
						savoir s'il y a matière à travailler.
					</p>
				</aside>
			</div>

			<div class="form-wrap">
				<ContactForm />
			</div>

			<p class="back"><a href="/">Revenir à l'accueil</a></p>
		</div>
	</section>
</BaseLayout>

<style>
	.top {
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
		gap: clamp(2rem, 5vw, 3.5rem);
		align-items: start;
		margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
	}

	h1 {
		font-size: var(--s-3);
		margin-bottom: 1.2rem;
	}

	.lead {
		font-size: var(--s-1);
		line-height: 1.55;
		color: rgba(238, 241, 247, 0.75);
		max-width: 48ch;
	}

	.box {
		padding: clamp(1.4rem, 3vw, 2rem);
		border-radius: var(--round);
		background: rgba(255, 255, 255, 0.07);
		border: 1px solid rgba(255, 255, 255, 0.14);
	}

	.box__t {
		font-family: var(--display);
		font-size: 0.74rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: #fff;
		opacity: 0.6;
		margin-bottom: 1.1rem;
	}

	.box__n {
		margin-top: 1.2rem;
		padding-top: 1.1rem;
		border-top: 1px solid rgba(255, 255, 255, 0.14);
		font-size: 0.8rem;
		line-height: 1.6;
		color: rgba(238, 241, 247, 0.6);
	}

	.form-wrap {
		max-width: 46rem;
	}

	.back {
		margin-top: 2.5rem;
		font-size: var(--s--1);
	}

	.back a {
		color: rgba(238, 241, 247, 0.7);
		text-underline-offset: 3px;
	}

	.back a:hover {
		color: #fff;
	}

	@media (max-width: 62rem) {
		.top {
			grid-template-columns: 1fr;
		}
	}
</style>
