---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_NAME, SITE_URL } from '../../data/site';

/**
 * Hub des pages ville. Meme role que les deux autres hubs.
 * Le tri se fait sur `nom`, donc « Le Mans » et « Le Havre » se rangent
 * a la lettre L, ce qui est la convention attendue en francais.
 */
const pages = (await getCollection('villes', ({ data }) => !data.draft)).sort((a, b) =>
	a.data.nom.localeCompare(b.data.nom, 'fr'),
);

const schema = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: 'Agence GEO par ville',
	url: `${SITE_URL}/villes/`,
	description:
		"Ce que les moteurs de réponse citent sur votre marché local, et qui occupe déjà la requête dans votre ville.",
	provider: { '@type': 'Organization', name: SITE_NAME, url: SITE_URL },
};
---

<BaseLayout
	title="Agence GEO par ville | Quoted"
	description="Ce que ChatGPT, Perplexity, Gemini, Claude et les AI Overviews répondent aux clients de votre ville, et qui occupe déjà la requête. Quinze villes relevées."
	noindex={pages.length === 0}
	schema={schema}
>
	<section class="intro">
		<div class="wrap">
			<p class="kick">Par ville</p>
			<h1>Votre ville, <span class="hi">vue par l'IA</span></h1>
			<p class="lede">
				Une question posée avec le nom de votre ville ne donne pas la même réponse que la
				même question sans. Pour chaque ville, nous indiquons qui occupe déjà la requête,
				relevé à l'appui. Nous ne sommes implantés dans aucune d'elles, et nous le disons
				sur chaque page.
			</p>
		</div>
	</section>

	<section class="band band--soft">
		<div class="wrap">
			{
				pages.length === 0 ? (
					<p class="vide">
						Les premières pages arrivent. En attendant, le <a href="/guide/">guide</a> couvre
						la méthode, tous marchés confondus.
					</p>
				) : (
					<ul class="grid">
						{pages.map((page, index) => (
							<li class="obs" style={`--d: ${index * 50}ms`}>
								<a href={`/villes/${page.id}/`}>
									<h2>{page.data.nom}<span class="dept"> ({page.data.departement})</span></h2>
									<p>{page.data.intro}</p>
									<span class="go">
										Voir la page <span class="arw" aria-hidden="true">→</span>
									</span>
								</a>
							</li>
						))}
					</ul>
				)
			}
		</div>
	</section>

	<section class="band">
		<div class="wrap closing obs">
			<h2>Votre ville n'est pas listée ?</h2>
			<p class="lede">
				Le relevé se fait sur vos questions, pas sur une liste de villes. Voyez aussi les
				pages <a href="/metiers/">par métier</a> et <a href="/secteurs/">par secteur</a>,
				ou décrivez-nous votre situation.
			</p>
			<a class="b b--go" href="/scan/">
				Scanner ma visibilité IA
				<span class="arw" aria-hidden="true">→</span>
			</a>
		</div>
	</section>
</BaseLayout>

<style>
	.intro {
		padding-block: clamp(2.5rem, 5vw, 4.5rem) clamp(2rem, 4vw, 3.5rem);
		background:
			radial-gradient(55% 70% at 85% 0%, var(--accent-wash), transparent 70%),
			var(--paper);
	}

	.intro h1 {
		margin-bottom: 1.35rem;
	}

	.vide {
		font-size: var(--s-1);
		color: var(--ink-soft);
	}

	.vide a {
		color: var(--accent);
		font-weight: 600;
	}

	.grid {
		list-style: none;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
		gap: clamp(0.8rem, 1.8vw, 1.2rem);
	}

	.grid a {
		display: grid;
		gap: 0.6rem;
		height: 100%;
		align-content: start;
		background: var(--paper);
		border: 1px solid var(--line);
		border-radius: var(--round);
		padding: clamp(1.25rem, 2.5vw, 1.8rem);
		text-decoration: none;
		transition:
			border-color 0.2s ease,
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}

	.grid a:hover {
		border-color: transparent;
		transform: translateY(-3px);
		box-shadow: var(--shadow);
	}

	.grid h2 {
		font-size: var(--s-1);
		text-transform: none;
	}

	.dept {
		font-weight: 500;
		color: var(--ink-mute);
	}

	.grid p {
		font-size: var(--s--1);
		line-height: 1.6;
		color: var(--ink-soft);
	}

	.go {
		font-family: var(--display);
		font-weight: 600;
		color: var(--accent-deep);
	}

	.closing {
		display: grid;
		justify-items: center;
		text-align: center;
		gap: 1.25rem;
	}

	.closing .lede {
		max-width: 46ch;
	}
</style>
