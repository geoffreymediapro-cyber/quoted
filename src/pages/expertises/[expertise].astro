---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_NAME, SITE_URL } from '../../data/site';

export const getStaticPaths = (async () => {
	const pages = await getCollection('expertises', ({ data }) => !data.draft);

	return pages.map((page) => ({
		params: { expertise: page.id },
		props: { page },
	}));
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const { Content } = await render(page);
const d = page.data;
const url = `${SITE_URL}/expertises/${page.id}/`;

const updated = d.updated.toLocaleDateString('fr-FR', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});

const schema = [
	{
		'@context': 'https://schema.org',
		'@type': 'Service',
		name: d.nom,
		description: d.description,
		url,
		serviceType: 'Generative Engine Optimization',
		areaServed: { '@type': 'Country', name: 'France' },
		provider: { '@type': 'Organization', name: SITE_NAME, url: SITE_URL },
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: d.faq.map((item) => ({
			'@type': 'Question',
			name: item.q,
			acceptedAnswer: { '@type': 'Answer', text: item.a },
		})),
	},
];
---

<BaseLayout title={`${d.title} | Quoted`} description={d.description} schema={schema}>
	<article>
		<header class="intro">
			<div class="wrap wrap--narrow">
				<nav class="crumbs" aria-label="Fil d'Ariane">
					<a href="/expertises/">Expertises</a>
					<span aria-hidden="true">/</span>
					<span>{d.nom}</span>
				</nav>

				<p class="kick">Expertise</p>
				<h1>{d.h1}</h1>
				<p class="lede">{d.intro}</p>

				<div class="acts">
					<a class="b b--go" href="/scan/">
						Demander le relevé
						<span class="arw" aria-hidden="true">→</span>
					</a>
					<a class="b b--line" href="/audit-geo/">Comment se passe un audit</a>
				</div>
			</div>
		</header>

		<section class="band band--soft">
			<div class="wrap wrap--narrow">
				<p class="kick">Le livrable</p>
				<h2>Ce que vous <span class="hi">recevez</span></h2>
				<ol class="liste">
					{
						d.livrables.map((item, i) => (
							<li>
								<span class="liste__n" aria-hidden="true">
									{String(i + 1).padStart(2, '0')}
								</span>
								<div>
									<h3>{item.t}</h3>
									<p>{item.d}</p>
								</div>
							</li>
						))
					}
				</ol>
			</div>
		</section>

		<section class="band">
			<div class="wrap wrap--narrow prose">
				<Content />
			</div>
		</section>

		{/* Lever la confusion est le coeur de ces pages, pas un ajout. */}
		<section class="band band--dark">
			<div class="wrap wrap--narrow on-dark">
				<p class="kick">Ne pas confondre</p>
				<h2>Ce que ce n'est <span class="hi">pas</span></h2>
				<ul class="pas">
					{
						d.pasCeQue.map((item) => (
							<li>
								<h3>{item.t}</h3>
								<p>{item.d}</p>
							</li>
						))
					}
				</ul>
			</div>
		</section>

		<section class="band band--soft">
			<div class="wrap wrap--narrow">
				<p class="kick">Questions fréquentes</p>
				<h2>Ce qu'on nous demande</h2>
				<div class="faq">
					{
						d.faq.map((item) => (
							<details class="qa" name="faq-expertise">
								<summary>
									<span>{item.q}</span>
									<span class="qa__s" aria-hidden="true" />
								</summary>
								<div class="qa__a">
									<p>{item.a}</p>
								</div>
							</details>
						))
					}
				</div>
				<p class="maj">Page mise à jour le {updated}</p>
			</div>
		</section>

		{
			d.liens.length > 0 && (
				<section class="band">
					<div class="wrap wrap--narrow">
						<p class="kick">À lire aussi</p>
						<h2>
							Les pages qui <span class="hi">se répondent</span>
						</h2>
						<ul class="liens">
							{d.liens.map((l) => (
								<li>
									<a href={l.href}>
										<span class="liens__t">
											{l.label}
											<span class="arw" aria-hidden="true">
												→
											</span>
										</span>
										<span class="liens__n">{l.note}</span>
									</a>
								</li>
							))}
						</ul>
					</div>
				</section>
			)
		}

		<aside class="band band--dark">
			<div class="wrap wrap--narrow cta">
				<h2>On commence par regarder</h2>
				<p>
					Avant toute production, nous rejouons vos questions sur les cinq moteurs et nous
					vous renvoyons ce qu'ils répondent, et qui ils citent. Gratuit, sous 48 h
					ouvrées, et il nous arrive de conclure qu'il n'y a pas matière à travailler.
				</p>
				<a class="b b--go" href="/scan/">
					Demander le relevé
					<span class="arw" aria-hidden="true">→</span>
				</a>
			</div>
		</aside>
	</article>
</BaseLayout>

<style>
	.intro {
		padding-block: clamp(2.25rem, 4.5vw, 3.5rem) clamp(2rem, 4vw, 3rem);
		background:
			radial-gradient(55% 70% at 90% 0%, var(--accent-wash), transparent 70%),
			var(--paper);
	}

	.crumbs {
		display: flex;
		gap: 0.5rem;
		font-size: var(--s--1);
		color: var(--ink-mute);
		margin-bottom: 1.5rem;
	}

	.crumbs a {
		color: var(--accent);
		font-weight: 600;
		text-decoration: none;
	}

	.crumbs a:hover {
		text-decoration: underline;
	}

	.intro h1 {
		font-size: var(--s-3);
		margin-bottom: 1.1rem;
	}

	.acts {
		display: flex;
		flex-wrap: wrap;
		gap: 0.7rem;
		margin-top: 1.9rem;
	}

	.liste {
		list-style: none;
		padding: 0;
		margin-top: 1.9rem;
		display: grid;
		gap: clamp(1.1rem, 2.5vw, 1.6rem);
	}

	.liste li {
		display: grid;
		grid-template-columns: 2.75rem minmax(0, 1fr);
		column-gap: clamp(0.9rem, 2vw, 1.4rem);
		row-gap: 0;
		align-items: start;
	}

	.liste__n {
		font-family: var(--display);
		font-size: var(--s-1);
		font-weight: 800;
		letter-spacing: -0.03em;
		color: var(--accent-line);
		padding-top: 0.1rem;
	}

	.liste h3 {
		font-size: var(--s-0);
		text-transform: none;
		margin-bottom: 0.4rem;
	}

	.liste p {
		font-size: var(--s--1);
		line-height: 1.6;
		color: var(--ink-soft);
		max-width: 62ch;
	}

	.pas {
		list-style: none;
		padding: 0;
		margin-top: 1.9rem;
		display: grid;
		gap: clamp(1.1rem, 2.5vw, 1.5rem);
	}

	.pas li {
		padding: clamp(1.2rem, 2.5vw, 1.6rem);
		border-radius: var(--round);
		background: rgba(255, 255, 255, 0.05);
		border: 1px solid rgba(255, 255, 255, 0.12);
	}

	.pas h3 {
		font-size: var(--s-0);
		color: #fff;
		margin-bottom: 0.45rem;
	}

	.pas p {
		font-size: var(--s--1);
		line-height: 1.6;
		color: rgba(238, 241, 247, 0.72);
		max-width: 64ch;
	}

	.faq {
		margin-top: 1.9rem;
	}

	.maj {
		margin-top: 2rem;
		font-size: 0.8rem;
		color: var(--ink-mute);
	}

	.liens {
		list-style: none;
		padding: 0;
		margin-top: 1.9rem;
		display: grid;
		gap: 0.7rem;
	}

	.liens a {
		display: grid;
		gap: 0.3rem;
		padding: clamp(1rem, 2vw, 1.3rem) clamp(1.1rem, 2.2vw, 1.45rem);
		border: 1px solid var(--line);
		border-radius: var(--round);
		text-decoration: none;
		transition:
			border-color 0.2s ease,
			background-color 0.2s ease;
	}

	.liens a:hover {
		border-color: var(--accent-line);
		background: var(--accent-wash);
	}

	.liens__t {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		font-family: var(--display);
		font-size: var(--s-0);
		font-weight: 700;
		color: var(--accent-deep);
	}

	.liens__n {
		font-size: var(--s--1);
		line-height: 1.55;
		color: var(--ink-soft);
	}

	.cta {
		display: grid;
		gap: 1rem;
		justify-items: start;
	}

	.cta p {
		font-size: var(--s-1);
		line-height: 1.5;
		color: rgba(234, 240, 251, 0.75);
		max-width: 54ch;
	}

	.cta .b {
		margin-top: 0.5rem;
	}

	@media (max-width: 40rem) {
		.liste li {
			grid-template-columns: 1fr;
			row-gap: 0.3rem;
		}
	}
</style>
