---
import BaseLayout from '../layouts/BaseLayout.astro';
import Home from '../components/home/Home.astro';
import { FAQ } from '../data/site';

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};
---

<BaseLayout
	title="Quoted, agence GEO : être cité par ChatGPT, Perplexity et Gemini"
	description="Agence GEO (Generative Engine Optimization) : audit de visibilité dans les moteurs de réponse, contenus conçus pour être cités, SEO technique et suivi mensuel des citations."
	schema={faqSchema}
>
	<Home />
</BaseLayout>
