---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Shift from '../components/Shift.astro';
import Offers from '../components/Offers.astro';
import Tiers from '../components/Tiers.astro';
import Method from '../components/Method.astro';
import Scope from '../components/Scope.astro';
import GuideTeaser from '../components/GuideTeaser.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import { FAQ } from '../data/site';

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};
---

<BaseLayout
	title="Quoted — agence GEO : être cité par ChatGPT, Perplexity et Gemini"
	description="Agence GEO (Generative Engine Optimization). Audit de visibilité dans les moteurs de réponse, contenus conçus pour être cités, suivi mensuel. Radar d'entrée à 1 500 €, accompagnement à partir de 400 €/mois."
	schema={faqSchema}
>
	<Hero />
	<Marquee />
	<Shift />
	<Offers />
	<Tiers />
	<Method />
	<Scope />
	<GuideTeaser />
	<Faq />
	<Cta />
</BaseLayout>
