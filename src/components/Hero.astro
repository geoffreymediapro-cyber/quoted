---
import AnswerPanel from './AnswerPanel.astro';

const proofs = [
	'Radar d’entrée à 1 500 €',
	'Sans engagement',
	'Périmètre écrit noir sur blanc',
];
---

<section class="hero">
	<span class="hero__glyph" aria-hidden="true">&ldquo;</span>

	<div class="shell hero__grid">
		<div class="hero__copy">
			<p class="hero__eyebrow rise">Agence GEO · Generative Engine Optimization</p>

			<h1 class="rise" style="--delay: 80ms">
				Être <span class="accent">cité</span> quand l'IA répond.
			</h1>

			<p class="hero__lede rise" style="--delay: 160ms">
				Vos prospects ne parcourent plus dix liens bleus : ils posent leur question à
				ChatGPT, Perplexity ou Gemini et repartent avec une réponse, et une poignée de
				sources. Quoted travaille votre place dans cette réponse.
			</p>

			<div class="hero__actions rise" style="--delay: 240ms">
				<a class="btn btn--primary" href="#contact">
					Demander le Radar
					<span class="btn__arrow" aria-hidden="true">→</span>
				</a>
				<a class="btn btn--ghost" href="#offre">Voir l'offre</a>
			</div>

			<ul class="hero__proofs rise" style="--delay: 320ms">
				{proofs.map((proof) => <li>{proof}</li>)}
			</ul>
		</div>

		<div class="hero__visual">
			<AnswerPanel />
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		padding-block: clamp(3.5rem, 8vw, 7rem) clamp(4rem, 8vw, 7rem);
		overflow: hidden;
	}

	/* Guillemet geant en filigrane : rappel du nom de la marque */
	.hero__glyph {
		position: absolute;
		top: clamp(-6rem, -8vw, -3rem);
		left: min(-2vw, -1rem);
		font-family: var(--display);
		font-size: clamp(22rem, 42vw, 44rem);
		line-height: 1;
		color: var(--violet);
		opacity: 0.045;
		pointer-events: none;
		user-select: none;
	}

	.hero__grid {
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
		gap: clamp(2.5rem, 6vw, 5rem);
		align-items: center;
	}

	.hero__eyebrow {
		font-size: var(--step--1);
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--violet);
		margin-bottom: 1.5rem;
	}

	.hero h1 {
		margin-bottom: 1.5rem;
	}

	.hero__lede {
		font-size: var(--step-1);
		line-height: 1.55;
		color: var(--ink-soft);
		max-width: 34ch;
		margin-bottom: 2rem;
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-bottom: 2.25rem;
	}

	.hero__proofs {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		list-style: none;
		padding: 0;
		font-size: var(--step--1);
		color: var(--ink-mute);
	}

	.hero__proofs li {
		display: flex;
		align-items: center;
		gap: 0.45rem;
	}

	.hero__proofs li::before {
		content: '';
		width: 0.4rem;
		height: 0.4rem;
		border-radius: 50%;
		background: var(--ember);
		flex: none;
	}

	@media (max-width: 62rem) {
		.hero__grid {
			grid-template-columns: 1fr;
			gap: 3rem;
		}

		.hero__lede {
			max-width: 46ch;
		}

		.hero__visual {
			max-width: 32rem;
		}
	}
</style>
