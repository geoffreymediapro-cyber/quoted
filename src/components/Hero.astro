---
import AnswerPanel from './AnswerPanel.astro';

const proofs = [
	'Diagnostic avant toute production',
	'Périmètre écrit noir sur blanc',
	'Sans engagement de durée',
];
---

<section class="hero">
	<div class="hero__grid-bg" aria-hidden="true"></div>

	<div class="shell hero__grid">
		<div class="hero__copy">
			<p class="hero__eyebrow rise">
				<span>GEO</span> Generative Engine Optimization
			</p>

			<h1 class="rise" style="--delay: 60ms">
				Être <span class="accent">cité</span><br />quand l'IA répond
			</h1>

			<p class="hero__lede rise" style="--delay: 120ms">
				Vos prospects ne parcourent plus dix liens bleus : ils posent leur question à
				ChatGPT, Perplexity ou Gemini et repartent avec une réponse, et une poignée de
				sources. Quoted travaille votre place dans cette réponse.
			</p>

			<div class="hero__actions rise" style="--delay: 180ms">
				<a class="btn btn--primary" href="#contact">
					Demander un diagnostic
					<span class="btn__arrow" aria-hidden="true">→</span>
				</a>
				<a class="btn btn--ghost" href="#expertise">Ce qu'on fait</a>
			</div>

			<ul class="hero__proofs rise" style="--delay: 240ms">
				{proofs.map((proof) => <li>{proof}</li>)}
			</ul>
		</div>

		<div class="hero__visual">
			<AnswerPanel />
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		padding-block: clamp(2.75rem, 6vw, 5.5rem) clamp(3rem, 6vw, 5.5rem);
		overflow: hidden;
	}

	/* Trame technique en fond, estompee vers le bas */
	.hero__grid-bg {
		position: absolute;
		inset: 0;
		background-image:
			linear-gradient(to right, var(--line) 1px, transparent 1px),
			linear-gradient(to bottom, var(--line) 1px, transparent 1px);
		background-size: 4.5rem 4.5rem;
		mask-image: radial-gradient(120% 90% at 20% 0%, #000 5%, transparent 70%);
		pointer-events: none;
	}

	.hero__grid {
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
		gap: clamp(2rem, 5vw, 4rem);
		align-items: center;
	}

	.hero__eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		font-family: var(--mono);
		font-size: var(--step--2);
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--ink-mute);
		margin-bottom: 1.35rem;
	}

	.hero__eyebrow span {
		background: var(--violet);
		color: #fff;
		padding: 0.15rem 0.45rem;
		letter-spacing: 0.08em;
	}

	.hero h1 {
		margin-bottom: 1.35rem;
	}

	.hero__lede {
		font-size: var(--step-1);
		line-height: 1.5;
		color: var(--ink-soft);
		max-width: 38ch;
		margin-bottom: 1.85rem;
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-bottom: 2rem;
	}

	.hero__proofs {
		display: grid;
		gap: 0.4rem;
		list-style: none;
		padding: 1.1rem 0 0;
		border-top: 1px solid var(--line);
		font-family: var(--mono);
		font-size: var(--step--2);
		letter-spacing: 0.04em;
		color: var(--ink-mute);
	}

	.hero__proofs li {
		display: flex;
		align-items: center;
		gap: 0.55rem;
	}

	.hero__proofs li::before {
		content: '';
		width: 0.35rem;
		height: 0.35rem;
		background: var(--ember);
		flex: none;
	}

	@media (max-width: 62rem) {
		.hero__grid {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}

		.hero__lede {
			max-width: 46ch;
		}

		.hero__visual {
			max-width: 32rem;
		}
	}
</style>
