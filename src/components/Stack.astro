---
import { TOOLS } from '../data/site';
---

<section class="section section--sunk" id="outils">
	<div class="shell">
		<div class="section-head reveal">
			<p class="eyebrow" data-num="05">Stack</p>
			<h2>Les outils du relevé, <span class="accent">rien de propriétaire</span></h2>
			<p>
				Aucune licence maison à vous refacturer. Ce sont les mêmes instruments que
				n'importe qui peut ouvrir&nbsp;: ce qui change, c'est le protocole appliqué
				dessus, et la régularité avec laquelle il est rejoué.
			</p>
		</div>

		<ul class="tools">
			{
				TOOLS.map((tool, index) => (
					<li class="tool reveal" style={`--delay: ${index * 35}ms`}>
						<span class="tool__code" aria-hidden="true">
							{tool.code}
						</span>
						<span class="tool__body">
							<span class="tool__name">{tool.name}</span>
							<span class="tool__use">{tool.use}</span>
						</span>
					</li>
				))
			}
		</ul>

		<p class="tools__note reveal">
			Les moteurs sont interrogés dans des conditions comparables d'un relevé à
			l'autre, et la version constatée est consignée à chaque campagne, sans quoi
			deux mesures ne se comparent pas.
		</p>
	</div>
</section>

<style>
	.tools {
		list-style: none;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		border: 1px solid var(--line);
		border-radius: var(--radius-lg);
		background: var(--paper-raised);
		overflow: hidden;
	}

	.tool {
		display: flex;
		align-items: center;
		gap: 0.8rem;
		padding: 0.95rem 1.1rem;
		transition: background-color 0.16s ease;
	}

	.tool:hover {
		background: var(--violet-wash);
	}

	/* Filets internes d'une grille a 4 colonnes */
	.tool:not(:nth-child(4n)) {
		border-right: 1px solid var(--line);
	}

	.tool:nth-child(n + 5) {
		border-top: 1px solid var(--line);
	}

	.tool__code {
		display: grid;
		place-items: center;
		flex: none;
		width: 2.3rem;
		height: 2.3rem;
		background: var(--ink);
		color: #fff;
		font-family: var(--mono);
		font-size: 0.62rem;
		font-weight: 500;
		letter-spacing: 0.02em;
		border-radius: var(--radius);
		transition: background-color 0.16s ease;
	}

	.tool:hover .tool__code {
		background: var(--violet);
	}

	.tool__body {
		display: grid;
		gap: 0.1rem;
		min-width: 0;
	}

	.tool__name {
		font-size: var(--step--1);
		font-weight: 700;
		letter-spacing: -0.015em;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.tool__use {
		font-family: var(--mono);
		font-size: 0.62rem;
		letter-spacing: 0.04em;
		color: var(--ink-mute);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.tools__note {
		margin-top: 1.5rem;
		padding-left: 1rem;
		border-left: 2px solid var(--ember);
		max-width: var(--measure);
		font-size: var(--step--1);
		color: var(--ink-soft);
	}

	@media (max-width: 68rem) {
		.tools {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		.tool:not(:nth-child(4n)) {
			border-right: 0;
		}

		.tool:not(:nth-child(3n)) {
			border-right: 1px solid var(--line);
		}

		.tool:nth-child(n + 4) {
			border-top: 1px solid var(--line);
		}
	}

	@media (max-width: 46rem) {
		.tools {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.tool:not(:nth-child(3n)) {
			border-right: 0;
		}

		.tool:nth-child(odd) {
			border-right: 1px solid var(--line);
		}

		.tool:nth-child(n + 3) {
			border-top: 1px solid var(--line);
		}
	}

	@media (max-width: 30rem) {
		.tools {
			grid-template-columns: 1fr;
		}

		.tool:nth-child(odd) {
			border-right: 0;
		}

		.tool:nth-child(n + 2) {
			border-top: 1px solid var(--line);
		}
	}
</style>
