---
import { getCollection } from 'astro:content';
import {
	EXPERTISES,
	METHOD,
	CLIENTS,
	PLACEHOLDER_CLIENTS,
	FAQ,
	CONTACT_EMAIL,
} from '../../data/site';

const guides = (await getCollection('guide', ({ data }) => !data.draft)).sort(
	(a, b) => a.data.order - b.data.order,
);

const proofs = [
	'Relevé avant toute production',
	'Méthode publiée en accès libre',
	'Périmètre écrit avant le devis',
	'Aucun outil facturé en licence',
];

/**
 * Surfaces de reponse. Le statut est honnete : ce qui est hors perimetre
 * l'est vraiment, et c'est ce qui rend le reste credible.
 */
const surfaces = [
	{ code: 'AI', name: 'AI Overviews', on: true },
	{ code: 'GPT', name: 'ChatGPT', on: true },
	{ code: 'PPX', name: 'Perplexity', on: true },
	{ code: 'GEM', name: 'Gemini', on: true },
	{ code: 'SEO', name: 'Google organique', on: true },
	{ code: 'RDT', name: 'Reddit et forums', on: true },
	{ code: 'WIK', name: 'Wikipédia et Wikidata', on: true },
	{ code: 'YT', name: 'YouTube et vidéo', on: false },
	{ code: 'SHP', name: 'Shopping et flux', on: false },
	{ code: 'ASO', name: 'App Store', on: false },
];

const covered = surfaces.filter((s) => s.on).length;

/**
 * Graphe du hero : visibilite par moteur, facon tableau de bord.
 * Trois metriques, celles que nous livrons reellement. Les valeurs sont
 * ILLUSTRATIVES et signalees comme telles : aucun client reel derriere.
 */
const models = ['ChatGPT', 'Perplexity', 'Gemini', 'AI Overviews'];

const metrics = [
	{
		id: 'presence',
		label: 'Taux de présence',
		note: 'Part des réponses où la marque est mentionnée.',
		values: [24, 40, 31, 18],
	},
	{
		id: 'citation',
		label: 'Taux de citation',
		note: 'Part des réponses où le domaine figure dans les sources.',
		values: [16, 34, 22, 11],
	},
	{
		id: 'voix',
		label: 'Part de voix',
		note: 'Poids de la marque face aux concurrents, à prompts identiques.',
		values: [21, 38, 27, 15],
	},
];

const scanSubject = encodeURIComponent('Scan de visibilité IA');
const scanBody = encodeURIComponent(
	`Bonjour,

Notre site :
Notre secteur :
Deux ou trois questions que nos clients posent avant d'acheter :
Un concurrent de référence :

Merci,`,
);
---

<!-- ===================== HERO ===================== -->
<section class="hero">
	<div class="hero__blob" aria-hidden="true"></div>

	<div class="wrap hero__grid">
		<div>
			<p class="kick up">Agence GEO · Generative Engine Optimization</p>

			<h1 class="up" style="--d: 60ms">
				Vos clients demandent.<br />
				<span class="hi">L'IA répond.</span><br />
				Elle cite qui ?
			</h1>

			<p class="hero__lede up" style="--d: 120ms">
				ChatGPT, Perplexity, Gemini, AI Overviews : sur ces surfaces, il ne reste que
				trois ou quatre sources à l'écran. Nous travaillons votre place parmi elles, et
				nous la mesurons chaque mois.
			</p>

			<div class="hero__act up" style="--d: 180ms">
				<a class="b b--go" href="#contact">
					Scanner ma visibilité IA
					<span class="arw" aria-hidden="true">→</span>
				</a>
				<a class="b b--line" href="#expertises">Nos expertises</a>
			</div>
		</div>

		<div class="hero__vis up" style="--d: 260ms">
			<figure class="ask">
				<span class="ask__dot" aria-hidden="true"></span>
				Quel logiciel de facturation pour une TPE en 2026 ?
			</figure>

			<figure class="chart">
				<div class="chart__bar">
					<span>Visibilité par moteur</span>
					<span class="chart__tag">Illustration</span>
				</div>

				<div class="chart__in">
					{/* Selecteur de metrique en CSS pur : chaque radio affiche sa serie. */}
					<div class="chart__tabs" role="group" aria-label="Métrique affichée">
						{
							metrics.map((metric, index) => (
								<>
									<input
										type="radio"
										name="metric"
										id={`m-${metric.id}`}
										class="chart__radio sr"
										checked={index === 0}
									/>
									<label for={`m-${metric.id}`}>{metric.label}</label>
								</>
							))
						}
					</div>

					<div class="chart__plot">
						{
							metrics.map((metric) => (
								<div class={`serie serie--${metric.id}`}>
									<div class="serie__plot">
										<div class="serie__ax" aria-hidden="true">
											<span>50 %</span>
											<span>25 %</span>
											<span>0</span>
										</div>

										<div class="serie__bars">
											{metric.values.map((value, i) => (
												<div class="bar">
													<span class="bar__v">{value}%</span>
													{/* axe cale sur 50 % : la hauteur vaut le double de la valeur */}
													<span class="bar__col" style={`--h: ${value * 2}%`} />
												</div>
											))}
										</div>

										<div class="serie__names">
											{models.map((model) => (
												<span>{model}</span>
											))}
										</div>
									</div>
									<p class="serie__n">{metric.note}</p>
								</div>
							))
						}
					</div>
				</div>
			</figure>
		</div>
	</div>
</section>

<!-- ===================== BARRE DE PREUVE ===================== -->
<div class="proof">
	<div class="wrap proof__in">
		{proofs.map((proof) => <span>{proof}</span>)}
	</div>
</div>

<!-- ===================== EXPERTISES ===================== -->
<section class="band" id="expertises">
	<div class="wrap">
		<div class="head obs">
			<p class="kick">Nos expertises</p>
			<h2>Le GEO d'abord, <span class="hi">le SEO avec</span></h2>
			<p>
				Être cité par une IA suppose d'être trouvable tout court. Nous travaillons les
				deux, et nous disons lequel des deux compte le plus dans votre cas.
			</p>
		</div>

		<ul class="exp">
			{
				EXPERTISES.map((item, index) => (
					<li class:list={['exp__c', 'obs', { 'exp__c--core': item.core }]} style={`--d: ${index * 35}ms`}>
						<div class="exp__h">
							<h3>{item.name}</h3>
							{item.core && <span class="exp__t">GEO</span>}
							{item.via && <span class="exp__t exp__t--via">{item.via}</span>}
						</div>
						<p>{item.note}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>

<!-- ===================== SURFACES ===================== -->
<section class="band band--soft" id="surfaces">
	<div class="wrap surf__wrap">
		<div class="head obs surf__head">
			<p class="kick">Couverture</p>
			<h2>Dix surfaces. <span class="hi">{covered} couvertes.</span></h2>
			<p>
				Vos clients ne cherchent pas au même endroit selon la question. Voici où nous
				intervenons, et où nous n'intervenons pas.
			</p>
		</div>

		<ul class="surf obs">
			{
				surfaces.map((surface) => (
					<li class:list={['surf__c', { off: !surface.on }]}>
						<span class="surf__code" aria-hidden="true">
							{surface.code}
						</span>
						<span class="surf__n">{surface.name}</span>
						<span class="surf__st">{surface.on ? 'Couvert' : 'Hors périmètre'}</span>
					</li>
				))
			}
		</ul>
	</div>
</section>

<!-- ===================== RESULTATS ===================== -->
<section class="band" id="resultats">
	<div class="wrap res__grid">
		<div class="obs">
			<p class="kick">Résultats</p>
			<h2>Une visibilité <span class="hi">notée</span>, pas racontée</h2>
			<p class="lede">
				Chaque mois, le même panel de prompts est rejoué sur les mêmes moteurs, dans
				les mêmes conditions. Vous recevez un score, sa variation, et la place que vous
				occupez face à vos concurrents sur exactement les mêmes questions.
			</p>
			<ul class="ticks res__l">
				<li>Le même panel, rejoué à l'identique, pour que deux mois se comparent</li>
				<li>Présence, citation et part de voix suivies séparément</li>
				<li>La version de chaque moteur consignée à chaque campagne</li>
			</ul>
		</div>

		<figure class="card obs" style="--d: 120ms">
			<div class="card__bar">
				<span>Rapport mensuel</span>
				<span class="card__tag">Illustration</span>
			</div>

			<div class="card__in">
				<div class="card__score">
					<div class="card__big">
						<strong>34</strong><span>/100</span>
					</div>
					<div class="card__meta">
						<p class="card__lab">Score de visibilité IA</p>
						<p class="card__delta">+6 points depuis le relevé précédent</p>
					</div>
				</div>

				<ul class="card__rows">
					<li><span>Panel rejoué</span><strong>30 prompts, 4 moteurs</strong></li>
					<li><span>Concurrents suivis</span><strong>4 acteurs</strong></li>
					<li><span>Période</span><strong>Mois précédent comparé</strong></li>
				</ul>

				<p class="card__note">
					Exemple de mise en forme. Les valeurs ne correspondent à aucun client.
				</p>
			</div>
		</figure>
	</div>
</section>

<!-- ===================== METHODE ===================== -->
<section class="band band--soft" id="methode">
	<div class="wrap">
		<div class="head obs">
			<p class="kick">Comment on travaille</p>
			<h2>Cinq temps, <span class="hi">dans cet ordre</span></h2>
		</div>

		<ol class="meth">
			{
				METHOD.map((step, index) => (
					<li class="meth__s obs" style={`--d: ${index * 50}ms`}>
						<span class="meth__n">{step.step}</span>
						<h3>{step.title}</h3>
						<p>{step.body}</p>
					</li>
				))
			}
		</ol>
	</div>
</section>

<!-- ===================== CLIENTS ===================== -->
<section class="band" id="clients">
	<div class="wrap">
		<div class="head obs">
			<p class="kick">Clients accompagnés</p>
			<h2>Les marques que <span class="hi">nous accompagnons</span></h2>
			<p>
				Nos références sont présentées sans nom, par choix : le profil, la situation de
				départ et le travail engagé.
			</p>
		</div>

		{
			PLACEHOLDER_CLIENTS && (
				<p class="todo obs">
					<strong>Section à compléter.</strong> Les profils ci-dessous sont un gabarit,
					pas des références réelles.
				</p>
			)
		}

		<div class="cli">
			<div class="cli__l">
				{
					CLIENTS.map((client, index) => (
						<article class="cli__c obs" style={`--d: ${index * 50}ms`}>
							<span class="cli__n">{String(index + 1).padStart(2, '0')}</span>
							<div>
								<h3>{client.sector}</h3>
								<p class="cli__p">{client.profile}</p>
							</div>
							<p class="cli__x">{client.context}</p>
						</article>
					))
				}
			</div>

			<aside class="cli__note obs">
				<h3>Pourquoi aucun logo</h3>
				<p>
					Travailler la visibilité d'une marque, c'est entrer dans sa stratégie de
					contenu et dans ses points faibles. Nous ne les affichons pas en vitrine.
				</p>
				<a class="b b--go" href="#contact">Demander des références</a>
			</aside>
		</div>
	</div>
</section>

<!-- ===================== RESSOURCES ===================== -->
<section class="band band--soft" id="ressources">
	<div class="wrap">
		<div class="head obs">
			<p class="kick">Ressources</p>
			<h2>Tout ce qu'on sait, <span class="hi">en accès libre</span></h2>
		</div>

		<div class="gui">
			{
				guides.map((guide, index) => (
					<a class="gui__c obs" href={`/guide/${guide.id}/`} style={`--d: ${index * 50}ms`}>
						<p class="gui__k">{guide.data.chapter}</p>
						<h3>{guide.data.title}</h3>
						<span class="gui__go">
							Lire <span class="arw" aria-hidden="true">→</span>
						</span>
					</a>
				))
			}
		</div>
	</div>
</section>

<!-- ===================== FAQ ===================== -->
<section class="band" id="faq">
	<div class="wrap">
		<div class="head obs">
			<p class="kick">Questions fréquentes</p>
			<h2>Ce qu'on nous demande <span class="hi">avant de signer</span></h2>
		</div>

		<div class="faq">
			{
				FAQ.map((item, index) => (
					<details class="qa obs" style={`--d: ${index * 30}ms`} name="faq">
						<summary>
							<span>{item.q}</span>
							<span class="qa__s" aria-hidden="true" />
						</summary>
						<div class="qa__a">
							<p>{item.a}</p>
						</div>
					</details>
				))
			}
		</div>
	</div>
</section>

<!-- ===================== CONTACT ===================== -->
<section class="band band--dark" id="contact">
	<div class="wrap fin on-dark">
		<div>
			<p class="kick obs">Le scan</p>
			<h2 class="obs" style="--d: 60ms">
				Voyons d'abord ce que l'IA <span class="hi">dit déjà</span> de vous
			</h2>
			<p class="fin__p obs" style="--d: 120ms">
				Envoyez-nous votre site, votre secteur et deux ou trois questions que vos
				clients posent avant d'acheter. Nous rejouons ces questions sur les moteurs et
				nous vous renvoyons ce qu'ils répondent, et qui ils citent.
			</p>
			<div class="fin__act obs" style="--d: 180ms">
				<a class="b b--go" href={`mailto:${CONTACT_EMAIL}?subject=${scanSubject}&body=${scanBody}`}>
					Scanner ma visibilité IA
					<span class="arw" aria-hidden="true">→</span>
				</a>
				<a class="b b--line" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
			</div>
		</div>

		<div class="fin__box obs" style="--d: 240ms">
			<p class="fin__bt">Ce que contient le scan</p>
			<ul class="ticks">
				<li>Cinq prompts de votre marché rejoués sur quatre moteurs</li>
				<li>Ce qui ressort, et les sources citées à chaque fois</li>
				<li>Si votre marque apparaît, et à quelle place</li>
				<li>Les deux ou trois écarts les plus évidents</li>
			</ul>
			<p class="fin__bn">
				Gratuit, sans engagement, et sans relance automatique derrière. Réponse sous
				48 h ouvrées. Ce n'est pas un audit complet : c'est un aperçu honnête pour
				savoir s'il y a matière à travailler.
			</p>
		</div>
	</div>
</section>

<style>
	/* ================= HERO ================= */
	.hero {
		position: relative;
		padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(2.5rem, 5vw, 4rem);
		overflow: hidden;
	}

	.hero__blob {
		position: absolute;
		top: -18%;
		right: -14%;
		width: 62%;
		height: 132%;
		background: var(--surface);
		border-radius: 46% 54% 40% 60% / 52% 44% 56% 48%;
		pointer-events: none;
	}

	.hero__grid {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1.02fr) minmax(0, 0.98fr);
		gap: clamp(2rem, 5vw, 3.5rem);
		align-items: center;
	}

	.hero h1 {
		font-size: var(--s-4);
	}

	.hero__lede {
		margin-block: 1.4rem 2rem;
		font-size: var(--s-1);
		line-height: 1.55;
		color: var(--ink-soft);
		max-width: 38ch;
	}

	.hero__act {
		display: flex;
		flex-wrap: wrap;
		gap: 0.7rem;
	}

	.hero__vis {
		position: relative;
		padding-top: 4.25rem;
	}

	.ask {
		position: absolute;
		top: 0;
		left: -3rem;
		z-index: 2;
		display: flex;
		align-items: center;
		gap: 0.6rem;
		max-width: 28rem;
		padding: 0.8rem 1.2rem;
		background: var(--accent);
		color: #fff;
		border-radius: 999px;
		font-size: 0.82rem;
		font-weight: 700;
		line-height: 1.3;
		box-shadow: var(--shadow);
	}

	.ask__dot {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: #fff;
		opacity: 0.7;
		flex: none;
	}

	/* ---- Graphe : visibilite par moteur ---- */
	.chart {
		background: var(--paper);
		border: 1px solid var(--line);
		border-radius: var(--round);
		box-shadow: var(--shadow);
		overflow: hidden;
	}

	.chart__in {
		padding: clamp(1.1rem, 2.4vw, 1.6rem);
	}

	.chart__tabs {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin-bottom: 1.4rem;
	}

	.chart__tabs label {
		padding: 0.35rem 0.8rem;
		border-radius: 999px;
		border: 1px solid var(--line);
		font-size: 0.72rem;
		font-weight: 700;
		color: var(--ink-mute);
		cursor: pointer;
		transition: background-color 0.16s ease, color 0.16s ease, border-color 0.16s ease;
	}

	.chart__tabs label:hover {
		border-color: var(--accent-line);
		color: var(--accent);
	}

	.chart__radio:checked + label {
		background: var(--accent);
		border-color: var(--accent);
		color: #fff;
	}

	.chart__radio:focus-visible + label {
		outline: 3px solid var(--accent);
		outline-offset: 2px;
	}

	/* Une seule serie visible a la fois, pilotee par le radio coche */
	.serie {
		display: none;
	}

	.chart__in:has(#m-presence:checked) .serie--presence,
	.chart__in:has(#m-citation:checked) .serie--citation,
	.chart__in:has(#m-voix:checked) .serie--voix {
		display: block;
	}

	/* Grille : axe des ordonnees a gauche, barres a droite, noms dessous */
	.serie__plot {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		column-gap: 0.7rem;
		row-gap: 0.55rem;
	}

	.serie__ax {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		height: 11.5rem;
		font-size: 0.62rem;
		font-weight: 600;
		color: var(--ink-mute);
		text-align: right;
	}

	/* Les libelles sont cales sur la ligne de niveau correspondante */
	.serie__ax span {
		transform: translateY(-0.4em);
	}

	.serie__ax span:last-child {
		transform: translateY(0.1em);
	}

	.serie__bars {
		display: flex;
		align-items: flex-end;
		gap: clamp(0.5rem, 2vw, 1.1rem);
		height: 11.5rem;
		/* Lignes de niveau a 0, 25 et 50 % */
		background-image: repeating-linear-gradient(
			to top,
			var(--line) 0 1px,
			transparent 1px 50%
		);
	}

	.serie__names {
		grid-column: 2;
		display: flex;
		gap: clamp(0.5rem, 2vw, 1.1rem);
	}

	.serie__names span {
		flex: 1;
		min-width: 0;
		font-size: 0.68rem;
		font-weight: 600;
		color: var(--ink-mute);
		text-align: center;
		line-height: 1.2;
	}

	.bar {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		align-items: center;
		height: 100%;
	}

	.bar__v {
		font-family: var(--display);
		font-size: 0.78rem;
		font-weight: 800;
		color: var(--ink);
		margin-bottom: 0.3rem;
	}

	.bar__col {
		width: 100%;
		max-width: 3rem;
		height: var(--h);
		border-radius: 7px 7px 0 0;
		background: linear-gradient(to top, var(--accent), color-mix(in srgb, var(--accent) 55%, #fff));
		transform-origin: bottom;
		animation: grow 0.7s cubic-bezier(0.16, 1, 0.3, 1) backwards;
	}

	.bar:nth-child(2) .bar__col {
		animation-delay: 80ms;
	}

	.bar:nth-child(3) .bar__col {
		animation-delay: 160ms;
	}

	.bar:nth-child(4) .bar__col {
		animation-delay: 240ms;
	}

	@keyframes grow {
		from {
			transform: scaleY(0);
		}
	}

	.serie__n {
		margin-top: 1.4rem;
		padding-top: 0.9rem;
		border-top: 1px solid var(--line);
		font-size: 0.74rem;
		line-height: 1.5;
		color: var(--ink-mute);
	}

	@media (prefers-reduced-motion: reduce) {
		.bar__col {
			animation: none;
		}
	}

	.chart__bar,
	.card__bar {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.85rem 1.2rem;
		background: var(--dark);
		color: #fff;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.chart__tag,
	.card__tag {
		margin-left: auto;
		padding: 0.15rem 0.55rem;
		border: 1px solid rgba(238, 241, 247, 0.28);
		border-radius: 999px;
		color: rgba(238, 241, 247, 0.6);
		font-size: 0.64rem;
	}

	/* ================= BARRE DE PREUVE ================= */
	.proof {
		background: var(--dark);
		color: #eef1f7;
	}

