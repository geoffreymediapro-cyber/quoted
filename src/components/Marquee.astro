---
const items = [
	'Exploration sémantique',
	'Cartographie des prompts',
	'Sources citées',
	'Données structurées',
	'E-E-A-T',
	'Maillage sémantique',
	'Reddit',
	'Wikipédia & Wikidata',
	'Netlinking média',
	'Suivi de visibilité',
];
---

<div class="band" role="presentation">
	<div class="band__track">
		{
			[0, 1].map((pass) => (
				<ul class="band__row" aria-hidden={pass === 1 ? 'true' : undefined}>
					{items.map((item) => (
						<li>
							{item}
							<span class="band__dot">·</span>
						</li>
					))}
				</ul>
			))
		}
	</div>
</div>

<style>
	.band {
		border-block: 1px solid var(--line);
		background: var(--paper-raised);
		overflow: hidden;
		padding-block: 0.9rem;
		/* Estompe les bords pour eviter la coupe seche */
		mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
	}

	.band__track {
		display: flex;
		width: max-content;
		animation: slide 42s linear infinite;
	}

	.band:hover .band__track {
		animation-play-state: paused;
	}

	.band__row {
		display: flex;
		align-items: center;
		gap: 0;
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.band__row li {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		padding-right: 1.5rem;
		font-size: var(--step--1);
		font-weight: 500;
		letter-spacing: 0.01em;
		color: var(--ink-mute);
		white-space: nowrap;
	}

	.band__dot {
		color: var(--violet);
	}

	@keyframes slide {
		to {
			transform: translateX(-50%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.band__track {
			animation: none;
		}
	}
</style>
