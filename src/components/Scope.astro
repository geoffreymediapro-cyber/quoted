---
import { SCOPE_IN, SCOPE_OUT } from '../data/site';
---

<section class="section" id="perimetre">
	<div class="shell">
		<div class="section-head reveal">
			<p class="eyebrow" data-num="05">Périmètre</p>
			<h2>Ce qu'on fait, et ce qu'on <span class="accent">refuse</span> de faire.</h2>
			<p>
				Un périmètre flou finit toujours par se payer, d'un côté ou de l'autre. Autant
				l'écrire avant le devis.
			</p>
		</div>

		<div class="scope">
			<div class="scope__in card reveal">
				<h3>Dans le périmètre</h3>
				<ul class="ticks">
					{SCOPE_IN.map((item) => <li>{item}</li>)}
				</ul>
			</div>

			<div class="scope__out reveal" style="--delay: 90ms">
				<h3>Hors périmètre</h3>
				<ul>
					{
						SCOPE_OUT.map((item) => (
							<li>
								<p class="scope__label">
									<span class="scope__cross" aria-hidden="true">
										✕
									</span>
									{item.label}
								</p>
								<p class="scope__detail">{item.detail}</p>
							</li>
						))
					}
				</ul>
			</div>
		</div>

		<div class="pledge reveal">
			<p class="pledge__quote">
				Pas d'outil propriétaire à vous facturer en licence. Le suivi de visibilité est
				inclus dans les jours d'accompagnement&nbsp;: vous payez du travail, pas un
				abonnement logiciel.
			</p>
			<p class="pledge__meta">
				En contrepartie, le reporting est produit à la main et livré par cycle — il n'y
				a pas de dashboard temps réel.
			</p>
		</div>
	</div>
</section>

<style>
	.scope {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 21rem), 1fr));
		gap: clamp(1.25rem, 3vw, 2rem);
		align-items: start;
	}

	.scope h3 {
		font-size: var(--step-2);
		margin-bottom: 1.35rem;
		padding-bottom: 0.9rem;
		border-bottom: 1px solid var(--line);
	}

	.scope__in h3 {
		color: var(--violet-deep);
	}

	.scope__in .ticks {
		font-size: var(--step-0);
	}

	.scope__out {
		padding: clamp(1.4rem, 2.6vw, 2rem);
	}

	.scope__out ul {
		list-style: none;
		padding: 0;
		display: grid;
		gap: 1.4rem;
	}

	.scope__label {
		display: flex;
		align-items: baseline;
		gap: 0.6rem;
		font-weight: 600;
		margin-bottom: 0.35rem;
	}

	.scope__cross {
		color: var(--ember);
		font-size: 0.85em;
	}

	.scope__detail {
		font-size: var(--step--1);
		line-height: 1.6;
		color: var(--ink-soft);
		padding-left: 1.5rem;
	}

	/* --- Engagement --- */
	.pledge {
		margin-top: clamp(2.5rem, 5vw, 4rem);
		padding-left: clamp(1.25rem, 3vw, 2.5rem);
		border-left: 3px solid var(--violet);
		max-width: 52rem;
	}

	.pledge__quote {
		font-family: var(--display);
		font-size: var(--step-2);
		line-height: 1.25;
		letter-spacing: -0.015em;
		margin-bottom: 0.9rem;
	}

	.pledge__meta {
		font-size: var(--step--1);
		color: var(--ink-mute);
	}
</style>
