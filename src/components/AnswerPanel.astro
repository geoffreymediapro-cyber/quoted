---
/**
 * Illustration du hero : une reponse generee par un moteur d'IA, avec sa
 * liste de sources. C'est la promesse du site rendue visible — la marque
 * cliente figure parmi les sources citees.
 * Contenu volontairement generique : aucune marque de moteur n'est imitee.
 */

const engines = ['ChatGPT', 'Perplexity', 'Gemini', 'Claude'];

const sources = [
	{ label: 'guide-comparatif.fr', kind: 'Média spécialisé' },
	{ label: 'votre-marque.fr', kind: 'Site de la marque', highlight: true },
	{ label: 'reddit.com / r/…', kind: 'Discussion' },
	{ label: 'fr.wikipedia.org', kind: 'Encyclopédie' },
];
---

<figure class="panel rise" style="--delay: 320ms">
	<div class="panel__chrome" aria-hidden="true">
		<span class="dot"></span><span class="dot"></span><span class="dot"></span>
		<span class="panel__label">Réponse générée</span>
	</div>

	<div class="panel__body">
		<p class="prompt">
			<span class="prompt__caret" aria-hidden="true"></span>
			« Quel prestataire choisir pour <em>…</em> ? »
		</p>

		<div class="answer">
			<p class="answer__line answer__line--text">
				Plusieurs acteurs ressortent régulièrement sur ce sujet.
				<mark>Votre marque</mark><span class="ref">2</span> est citée pour
			</p>
			<span class="answer__line bar" style="--w: 96%; --delay: 620ms"></span>
			<span class="answer__line bar" style="--w: 88%; --delay: 700ms"></span>
			<span class="answer__line bar" style="--w: 62%; --delay: 780ms"></span>
		</div>

		<div class="sources">
			<p class="sources__title">Sources citées</p>
			<ul>
				{
					sources.map((source, index) => (
						<li
							class:list={['source', { 'source--on': source.highlight }]}
							style={`--delay: ${880 + index * 90}ms`}
						>
							<span class="source__num">{index + 1}</span>
							<span class="source__label">{source.label}</span>
							<span class="source__kind">{source.kind}</span>
						</li>
					))
				}
			</ul>
		</div>
	</div>

	<div class="panel__engines">
		{engines.map((engine) => <span class="engine">{engine}</span>)}
	</div>

	<figcaption class="visually-hidden">
		Illustration d'une réponse générée par un moteur d'IA citant la marque parmi ses
		sources.
	</figcaption>
</figure>

<style>
	.panel {
		background: var(--paper-raised);
		border: 1px solid var(--line);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-float);
		overflow: hidden;
		position: relative;
	}

	/* Halo violet derriere le panneau */
	.panel::before {
		content: '';
		position: absolute;
		inset: -30% -20% 40% -20%;
		background: radial-gradient(
			60% 60% at 50% 40%,
			rgba(75, 51, 224, 0.16),
			transparent 70%
		);
		pointer-events: none;
	}

	.panel__chrome {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.75rem 1rem;
		border-bottom: 1px solid var(--line);
		background: var(--paper-sunk);
	}

	.dot {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: var(--line-strong);
	}

	.panel__label {
		margin-left: auto;
		font-size: 0.66rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--ink-mute);
	}

	.panel__body {
		padding: clamp(1.2rem, 3vw, 1.85rem);
		position: relative;
	}

	/* --- Prompt --- */
	.prompt {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		padding-bottom: 1.1rem;
		margin-bottom: 1.25rem;
		border-bottom: 1px dashed var(--line-strong);
		font-size: var(--step--1);
		color: var(--ink-soft);
	}

	.prompt em {
		color: var(--ink-mute);
	}

	.prompt__caret {
		width: 2px;
		height: 0.95em;
		background: var(--violet);
		animation: blink 1.15s steps(2, start) infinite;
		flex: none;
	}

	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	/* --- Reponse --- */
	.answer {
		display: grid;
		gap: 0.6rem;
		margin-bottom: 1.6rem;
	}

	.answer__line--text {
		font-size: var(--step--1);
		line-height: 1.7;
		animation: fade 0.6s ease backwards;
		animation-delay: 540ms;
	}

	mark {
		background: none;
		color: var(--violet);
		font-weight: 600;
		box-shadow: inset 0 -0.45em 0 var(--violet-wash);
	}

	.bar {
		display: block;
		height: 0.58rem;
		width: var(--w);
		border-radius: 999px;
		background: linear-gradient(90deg, var(--paper-sunk), #eeeaf6);
		animation: grow 0.7s cubic-bezier(0.16, 1, 0.3, 1) backwards;
		animation-delay: var(--delay);
		transform-origin: left;
	}

	@keyframes grow {
		from {
			transform: scaleX(0);
			opacity: 0;
		}
	}

	@keyframes fade {
		from {
			opacity: 0;
			transform: translateY(6px);
		}
	}

	/* --- Sources --- */
	.sources__title {
		font-size: 0.66rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--ink-mute);
		margin-bottom: 0.7rem;
	}

	.sources ul {
		list-style: none;
		padding: 0;
		display: grid;
		gap: 0.35rem;
	}

	.source {
		display: grid;
		grid-template-columns: 1.35rem 1fr auto;
		gap: 0.7rem;
		align-items: center;
		padding: 0.55rem 0.7rem;
		border: 1px solid transparent;
		border-radius: var(--radius);
		font-size: 0.82rem;
		animation: fade 0.55s ease backwards;
		animation-delay: var(--delay);
	}

	.source__num {
		display: grid;
		place-items: center;
		width: 1.35rem;
		height: 1.35rem;
		border-radius: 50%;
		background: var(--paper-sunk);
		color: var(--ink-mute);
		font-size: 0.68rem;
		font-weight: 600;
	}

	.source__label {
		color: var(--ink-soft);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.source__kind {
		font-size: 0.68rem;
		color: var(--ink-mute);
		white-space: nowrap;
	}

	.source--on {
		background: var(--violet-wash);
		border-color: var(--violet-edge);
	}

	.source--on .source__num {
		background: var(--violet);
		color: #fff;
	}

	.source--on .source__label {
		color: var(--violet-deep);
		font-weight: 600;
	}

	.source--on .source__kind {
		color: var(--violet);
	}

	/* --- Pied : moteurs testes --- */
	.panel__engines {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		padding: 0.85rem clamp(1.2rem, 3vw, 1.85rem);
		border-top: 1px solid var(--line);
		background: var(--paper-sunk);
	}

	.engine {
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		color: var(--ink-mute);
		padding: 0.25rem 0.6rem;
		border: 1px solid var(--line-strong);
		border-radius: 999px;
		background: var(--paper-raised);
	}

	@media (max-width: 26rem) {
		.source {
			grid-template-columns: 1.35rem 1fr;
		}

		.source__kind {
			display: none;
		}
	}
</style>
