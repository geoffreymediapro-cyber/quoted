---
/**
 * Illustration du hero : une reponse generee par un moteur d'IA, avec sa
 * liste de sources. C'est la promesse du site rendue visible — la marque
 * cliente figure parmi les sources citees.
 * Contenu volontairement generique : aucune marque de moteur n'est imitee.
 */

const engines = ['ChatGPT', 'Perplexity', 'Gemini', 'Claude'];

const sources = [
	{ label: 'guide-comparatif.fr', kind: 'Média spécialisé' },
	{ label: 'votre-marque.fr', kind: 'Site de la marque', highlight: true },
	{ label: 'reddit.com / r/…', kind: 'Discussion' },
	{ label: 'fr.wikipedia.org', kind: 'Encyclopédie' },
];
---

<figure class="panel rise" style="--delay: 280ms">
	<div class="panel__chrome">
		<span class="panel__dot" aria-hidden="true"></span>
		<span class="panel__label">Réponse générée</span>
		<span class="panel__live" aria-hidden="true">live</span>
	</div>

	<div class="panel__body">
		<p class="prompt">
			<span class="prompt__caret" aria-hidden="true"></span>
			« Quel prestataire choisir pour <em>…</em> ? »
		</p>

		<div class="answer">
			<p class="answer__text">
				Plusieurs acteurs ressortent régulièrement sur ce sujet.
				<mark>Votre marque</mark><sup>2</sup> est citée pour
			</p>
			<span class="bar" style="--w: 96%; --delay: 560ms"></span>
			<span class="bar" style="--w: 88%; --delay: 630ms"></span>
			<span class="bar" style="--w: 62%; --delay: 700ms"></span>
		</div>

		<div class="sources">
			<p class="sources__title">Sources citées</p>
			<ul>
				{
					sources.map((source, index) => (
						<li
							class:list={['source', { 'source--on': source.highlight }]}
							style={`--delay: ${790 + index * 80}ms`}
						>
							<span class="source__num">{index + 1}</span>
							<span class="source__label">{source.label}</span>
							<span class="source__kind">{source.kind}</span>
						</li>
					))
				}
			</ul>
		</div>
	</div>

	<div class="panel__engines">
		{engines.map((engine) => <span class="engine">{engine}</span>)}
	</div>

	<figcaption class="visually-hidden">
		Illustration d'une réponse générée par un moteur d'IA citant la marque parmi ses
		sources.
	</figcaption>
</figure>

<style>
	.panel {
		background: var(--paper-raised);
		border: 1px solid var(--ink);
		border-radius: var(--radius-lg);
		overflow: hidden;
	}

	/* --- Barre de titre --- */
	.panel__chrome {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.65rem 0.9rem;
		background: var(--ink);
		color: #fff;
	}

	.panel__dot {
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 50%;
		background: var(--ember);
	}

	.panel__label,
	.panel__live {
		font-family: var(--mono);
		font-size: var(--step--2);
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.panel__live {
		margin-left: auto;
		color: rgba(238, 240, 244, 0.5);
	}

	.panel__body {
		padding: clamp(1.1rem, 2.5vw, 1.6rem);
	}

	/* --- Prompt --- */
	.prompt {
		display: flex;
		align-items: baseline;
		gap: 0.45rem;
		padding-bottom: 1rem;
		margin-bottom: 1.15rem;
		border-bottom: 1px solid var(--line);
		font-size: var(--step--1);
		color: var(--ink-soft);
	}

	.prompt em {
		color: var(--ink-mute);
		font-style: normal;
	}

	.prompt__caret {
		width: 2px;
		height: 0.9em;
		background: var(--violet);
		animation: blink 1.1s steps(2, start) infinite;
		flex: none;
	}

	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	/* --- Reponse --- */
	.answer {
		display: grid;
		gap: 0.55rem;
		margin-bottom: 1.5rem;
	}

	.answer__text {
		font-size: var(--step--1);
		line-height: 1.65;
		animation: fade 0.5s ease backwards;
		animation-delay: 480ms;
	}

	mark {
		background: var(--violet-wash);
		color: var(--violet-deep);
		font-weight: 700;
		padding: 0 0.15em;
	}

	sup {
		font-family: var(--mono);
		font-size: 0.6em;
		color: var(--ember);
		margin-left: 0.1em;
	}

	.bar {
		display: block;
		height: 0.5rem;
		width: var(--w);
		background: var(--paper-sunk);
		border: 1px solid var(--line);
		animation: grow 0.55s cubic-bezier(0.16, 1, 0.3, 1) backwards;
		animation-delay: var(--delay);
		transform-origin: left;
	}

	@keyframes grow {
		from {
			transform: scaleX(0);
			opacity: 0;
		}
	}

	@keyframes fade {
		from {
			opacity: 0;
			transform: translateY(5px);
		}
	}

	/* --- Sources --- */
	.sources__title {
		font-family: var(--mono);
		font-size: var(--step--2);
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--ink-mute);
		margin-bottom: 0.6rem;
	}

	.sources ul {
		list-style: none;
		padding: 0;
		display: grid;
		border: 1px solid var(--line);
	}

	.source {
		display: grid;
		grid-template-columns: 1.2rem 1fr auto;
		gap: 0.65rem;
		align-items: center;
		padding: 0.5rem 0.65rem;
		font-size: 0.8rem;
		animation: fade 0.5s ease backwards;
		animation-delay: var(--delay);
	}

	.source + .source {
		border-top: 1px solid var(--line);
	}

	.source__num {
		display: grid;
		place-items: center;
		width: 1.2rem;
		height: 1.2rem;
		background: var(--paper-sunk);
		color: var(--ink-mute);
		font-family: var(--mono);
		font-size: 0.62rem;
	}

	.source__label {
		color: var(--ink-soft);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.source__kind {
		font-family: var(--mono);
		font-size: 0.62rem;
		letter-spacing: 0.04em;
		color: var(--ink-mute);
		white-space: nowrap;
	}

	.source--on {
		background: var(--violet-wash);
	}

	.source--on .source__num {
		background: var(--violet);
		color: #fff;
	}

	.source--on .source__label {
		color: var(--violet-deep);
		font-weight: 700;
	}

	.source--on .source__kind {
		color: var(--violet);
	}

	/* --- Pied : moteurs testes --- */
	.panel__engines {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		padding: 0.75rem clamp(1.1rem, 2.5vw, 1.6rem);
		border-top: 1px solid var(--line);
		background: var(--paper-sunk);
	}

	.engine {
		font-family: var(--mono);
		font-size: 0.62rem;
		letter-spacing: 0.06em;
		color: var(--ink-soft);
		padding: 0.2rem 0.5rem;
		border: 1px solid var(--line-strong);
		background: var(--paper-raised);
	}

	@media (max-width: 26rem) {
		.source {
			grid-template-columns: 1.2rem 1fr;
		}

		.source__kind {
			display: none;
		}
	}
</style>
