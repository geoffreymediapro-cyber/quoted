---
import { Image } from 'astro:assets';

/**
 * Visuel du hero : ce que devient une recherche quand un moteur redige la
 * reponse. La marque cliente figure parmi les sources citees.
 *
 * Deux modes :
 *  1. Si une capture reelle existe dans src/assets/hero-answer.(png|jpg|webp),
 *     elle est utilisee telle quelle. C'est le mode a privilegier : rien ne
 *     vaut une vraie reponse d'AI Overview, de Gemini ou de Perplexity.
 *  2. Sinon, l'illustration ci-dessous prend le relais. Elle est explicitement
 *     signalee comme illustration et n'imite aucune interface existante.
 */

const found = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/hero-answer.{png,jpg,jpeg,webp,avif}',
	{ eager: true },
);
const screenshot = Object.values(found)[0]?.default;

const engines = ['ChatGPT', 'Perplexity', 'Gemini', 'AI Overviews'];

const sources = [
	{ n: 1, label: 'votre-marque.fr', kind: 'Site de la marque', highlight: true },
	{ n: 2, label: 'guide-comparatif.fr', kind: 'Média spécialisé' },
	{ n: 3, label: 'reddit.com / r/…', kind: 'Discussion' },
	{ n: 4, label: 'fr.wikipedia.org', kind: 'Encyclopédie' },
];
---

{
	screenshot ? (
		<figure class="shot rise" style="--delay: 280ms">
			<Image
				src={screenshot}
				alt="Réponse générée par un moteur d'IA affichant la liste des sources qu'il cite."
				widths={[560, 840, 1120]}
				sizes="(max-width: 62rem) 92vw, 40rem"
				loading="eager"
			/>
		</figure>
	) : (
		<figure class="panel rise" style="--delay: 280ms">
			<div class="panel__chrome">
				<span class="panel__dot" aria-hidden="true" />
				<span class="panel__label">Réponse générée</span>
				<span class="panel__tag">Illustration</span>
			</div>

			<div class="panel__body">
				<p class="prompt">
					<span class="prompt__caret" aria-hidden="true" />
					Quel logiciel de facturation pour une TPE en 2026 ?
				</p>

				<div class="answer">
					<p>
						Trois solutions reviennent régulièrement sur ce besoin.
						<mark>Votre marque</mark>
						<sup>1</sup> est citée pour sa conformité à la facturation électronique et
						sa prise en main rapide<sup>2</sup>. Les retours d'utilisateurs vont dans
						le même sens sur la qualité du support<sup>3</sup>.
					</p>
				</div>

				<div class="sources">
					<p class="sources__title">Sources citées</p>
					<ul>
						{sources.map((source, index) => (
							<li
								class:list={['source', { 'source--on': source.highlight }]}
								style={`--delay: ${640 + index * 80}ms`}
							>
								<span class="source__num">{source.n}</span>
								<span class="source__label">{source.label}</span>
								<span class="source__kind">{source.kind}</span>
							</li>
						))}
					</ul>
				</div>
			</div>

			<div class="panel__engines">
				{engines.map((engine) => (
					<span class="engine">{engine}</span>
				))}
			</div>
		</figure>
	)
}

<style>
	/* --- Mode capture reelle --- */
	.shot {
		margin: 0;
		border: 1px solid var(--ink);
		border-radius: var(--radius-lg);
		overflow: hidden;
	}

	.shot :global(img) {
		width: 100%;
		height: auto;
		display: block;
	}

	/* --- Mode illustration --- */
	.panel {
		margin: 0;
		background: var(--paper-raised);
		border: 1px solid var(--ink);
		border-radius: var(--radius-lg);
		overflow: hidden;
	}

	.panel__chrome {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.65rem 0.9rem;
		background: var(--ink);
		color: #fff;
	}

	.panel__dot {
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 50%;
		background: var(--ember);
	}

	.panel__label,
	.panel__tag {
		font-family: var(--mono);
		font-size: var(--step--2);
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	/* Mention explicite : ce panneau n'est pas une capture */
	.panel__tag {
		margin-left: auto;
		padding: 0.1rem 0.4rem;
		border: 1px solid rgba(238, 240, 244, 0.3);
		color: rgba(238, 240, 244, 0.6);
		letter-spacing: 0.08em;
	}

	.panel__body {
		padding: clamp(1.1rem, 2.5vw, 1.6rem);
	}

	.prompt {
		display: flex;
		align-items: baseline;
		gap: 0.45rem;
		padding-bottom: 1rem;
		margin-bottom: 1.15rem;
		border-bottom: 1px solid var(--line);
		font-size: var(--step--1);
		font-weight: 700;
		color: var(--ink);
	}

	.prompt__caret {
		width: 2px;
		height: 0.9em;
		background: var(--violet);
		animation: blink 1.1s steps(2, start) infinite;
		flex: none;
	}

	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	.answer {
		margin-bottom: 1.5rem;
		animation: fade 0.5s ease backwards;
		animation-delay: 460ms;
	}

	.answer p {
		font-size: var(--step--1);
		line-height: 1.7;
		color: var(--ink-soft);
	}

	mark {
		background: var(--violet-wash);
		color: var(--violet-deep);
		font-weight: 700;
		padding: 0 0.15em;
	}

	sup {
		font-family: var(--mono);
		font-size: 0.62em;
		color: var(--ember);
		margin-left: 0.08em;
	}

	@keyframes fade {
		from {
			opacity: 0;
			transform: translateY(5px);
		}
	}

	.sources__title {
		font-family: var(--mono);
		font-size: var(--step--2);
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--ink-mute);
		margin-bottom: 0.6rem;
	}

	.sources ul {
		list-style: none;
		padding: 0;
		display: grid;
		border: 1px solid var(--line);
	}

	.source {
		display: grid;
		grid-template-columns: 1.2rem 1fr auto;
		gap: 0.65rem;
		align-items: center;
		padding: 0.5rem 0.65rem;
		font-size: 0.8rem;
		animation: fade 0.5s ease backwards;
		animation-delay: var(--delay);
	}

	.source + .source {
		border-top: 1px solid var(--line);
	}

	.source__num {
		display: grid;
		place-items: center;
		width: 1.2rem;
		height: 1.2rem;
		background: var(--paper-sunk);
		color: var(--ink-mute);
		font-family: var(--mono);
		font-size: 0.62rem;
	}

	.source__label {
		color: var(--ink-soft);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.source__kind {
		font-family: var(--mono);
		font-size: 0.62rem;
		letter-spacing: 0.04em;
		color: var(--ink-mute);
		white-space: nowrap;
	}

	.source--on {
		background: var(--violet-wash);
	}

	.source--on .source__num {
		background: var(--violet);
		color: #fff;
	}

	.source--on .source__label {
		color: var(--violet-deep);
		font-weight: 700;
	}

	.source--on .source__kind {
		color: var(--violet);
	}

	.panel__engines {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		padding: 0.75rem clamp(1.1rem, 2.5vw, 1.6rem);
		border-top: 1px solid var(--line);
		background: var(--paper-sunk);
	}

	.engine {
		font-family: var(--mono);
		font-size: 0.62rem;
		letter-spacing: 0.06em;
		color: var(--ink-soft);
		padding: 0.2rem 0.5rem;
		border: 1px solid var(--line-strong);
		background: var(--paper-raised);
	}

	@media (max-width: 26rem) {
		.source {
			grid-template-columns: 1.2rem 1fr;
		}

		.source__kind {
			display: none;
		}
	}
</style>
