---
import { getCollection } from 'astro:content';

const entries = (await getCollection('guide', ({ data }) => !data.draft)).sort(
	(a, b) => a.data.order - b.data.order,
);
---

<section class="section" id="guide">
	<div class="shell">
		<div class="section-head reveal">
			<p class="eyebrow" data-num="06">Guide</p>
			<h2>Tout ce qu'on sait, <span class="accent">écrit</span>.</h2>
			<p>
				La méthode n'est pas un secret commercial. Si vous préférez l'appliquer
				vous-même, le guide est là pour ça.
			</p>
		</div>

		<ol class="guide-list">
			{
				entries.map((entry, index) => (
					<li class="reveal" style={`--delay: ${index * 70}ms`}>
						<a href={`/guide/${entry.id}/`}>
							<span class="guide-list__num" aria-hidden="true">
								{String(index + 1).padStart(2, '0')}
							</span>
							<span class="guide-list__body">
								<span class="guide-list__chapter">{entry.data.chapter}</span>
								<span class="guide-list__title">{entry.data.title}</span>
								<span class="guide-list__desc">{entry.data.description}</span>
							</span>
							<span class="guide-list__arrow" aria-hidden="true">
								→
							</span>
						</a>
					</li>
				))
			}
		</ol>

		<a class="btn btn--ghost guide-list__more" href="/guide/">Ouvrir le guide</a>
	</div>
</section>

<style>
	.guide-list {
		list-style: none;
		padding: 0;
		border-top: 1px solid var(--line);
	}

	.guide-list li {
		border-bottom: 1px solid var(--line);
	}

	.guide-list a {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		gap: clamp(1rem, 3vw, 2.5rem);
		align-items: baseline;
		padding-block: clamp(1.4rem, 3vw, 2rem);
		text-decoration: none;
		transition: padding-inline 0.3s cubic-bezier(0.2, 0.8, 0.3, 1);
	}

	.guide-list a:hover {
		padding-inline: 0.75rem;
	}

	.guide-list__num {
		font-family: var(--mono);
		font-size: var(--step--2);
		font-weight: 500;
		letter-spacing: 0.08em;
		color: var(--violet);
		padding-top: 0.35rem;
	}

	.guide-list__body {
		display: grid;
		gap: 0.35rem;
	}

	.guide-list__chapter {
		font-family: var(--mono);
		font-size: var(--step--2);
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--ink-mute);
	}

	.guide-list__title {
		font-size: var(--step-2);
		font-weight: 700;
		line-height: 1.12;
		letter-spacing: -0.03em;
		transition: color 0.18s ease;
	}

	.guide-list a:hover .guide-list__title {
		color: var(--violet);
	}

	.guide-list__desc {
		font-size: var(--step--1);
		line-height: 1.55;
		color: var(--ink-soft);
		max-width: 60ch;
	}

	.guide-list__arrow {
		color: var(--violet);
		transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.3, 1);
	}

	.guide-list a:hover .guide-list__arrow {
		transform: translateX(4px);
	}

	.guide-list__more {
		margin-top: 2rem;
	}

	@media (max-width: 40rem) {
		.guide-list a {
			grid-template-columns: auto minmax(0, 1fr);
		}

		.guide-list__arrow {
			display: none;
		}
	}
</style>
