---
import { CONTACT_EMAIL, FORM_KEY } from '../data/site';

/**
 * Formulaire de scan. Le site est statique : l'envoi passe par Web3Forms,
 * appele en fetch pour rester sur la page et afficher un etat de reponse.
 * Le champ `botcheck` est un piege a robots, masque aux humains.
 *
 * Tant que FORM_KEY est vide, la soumission bascule sur un mailto
 * pre-rempli : le formulaire reste utilisable, rien ne part dans le vide
 * sans que l'utilisateur le voie.
 */
---

<form class="form" data-form data-key={FORM_KEY} data-mail={CONTACT_EMAIL}>
	<div class="form__row">
		<label class="field">
			<span>Votre site</span>
			<input type="url" name="site" placeholder="https://…" required />
		</label>

		<label class="field">
			<span>Votre e-mail</span>
			<input type="email" name="email" placeholder="vous@entreprise.fr" required />
		</label>
	</div>

	<label class="field">
		<span>Votre secteur</span>
		<input type="text" name="secteur" placeholder="Logiciel de facturation, cabinet de recrutement…" required />
	</label>

	<label class="field">
		<span>Deux ou trois questions que vos clients posent avant d'acheter</span>
		<textarea
			name="questions"
			rows="3"
			placeholder="Quel logiciel de facturation pour une TPE ? Comment choisir un prestataire pour…"
			required></textarea>
	</label>

	<label class="field">
		<span>Un concurrent de référence <em>(facultatif)</em></span>
		<input type="text" name="concurrent" placeholder="Nom ou site" />
	</label>

	<!-- Piege a robots : un humain ne le voit pas, un script le remplit -->
	<input type="checkbox" name="botcheck" class="sr" tabindex="-1" autocomplete="off" />

	<div class="form__foot">
		<button class="b b--go" type="submit" data-submit>
			Demander mon scan
			<span class="arw" aria-hidden="true">→</span>
		</button>
		<p class="form__legal">
			Vos informations servent uniquement à préparer et à vous envoyer ce scan. Elles ne
			sont ni cédées ni utilisées pour de la prospection automatisée. Voir la
			<a href="/politique-de-confidentialite/">politique de confidentialité</a>.
		</p>
	</div>

	<p class="form__msg" data-msg role="status" aria-live="polite"></p>
</form>

<style>
	.form {
		display: grid;
		gap: 0.9rem;
	}

	.form__row {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.9rem;
	}

	.field {
		display: grid;
		gap: 0.4rem;
	}

	.field > span {
		font-size: 0.78rem;
		font-weight: 700;
		color: rgba(238, 241, 247, 0.8);
	}

	.field em {
		font-style: normal;
		font-weight: 500;
		color: rgba(238, 241, 247, 0.5);
	}

	.field input,
	.field textarea {
		width: 100%;
		padding: 0.8rem 1rem;
		border-radius: var(--round-sm);
		border: 1px solid rgba(255, 255, 255, 0.18);
		background: rgba(255, 255, 255, 0.07);
		color: #fff;
		font-size: var(--s--1);
		font-family: inherit;
		resize: vertical;
		transition: border-color 0.16s ease, background-color 0.16s ease;
	}

	.field input::placeholder,
	.field textarea::placeholder {
		color: rgba(238, 241, 247, 0.4);
	}

	.field input:focus,
	.field textarea:focus {
		outline: none;
		border-color: #fff;
		background: rgba(255, 255, 255, 0.12);
	}

	.field input:user-invalid,
	.field textarea:user-invalid {
		border-color: #ff9b8a;
	}

	.form__foot {
		display: grid;
		gap: 0.9rem;
		margin-top: 0.4rem;
	}

	.form__foot .b {
		justify-self: start;
	}

	.form__foot .b[disabled] {
		opacity: 0.6;
		cursor: wait;
	}

	.form__legal {
		font-size: 0.74rem;
		line-height: 1.55;
		color: rgba(238, 241, 247, 0.55);
		max-width: 56ch;
	}

	.form__legal a {
		color: #fff;
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.form__msg {
		font-size: var(--s--1);
		font-weight: 600;
		min-height: 1.4em;
	}

	.form__msg[data-state='ok'] {
		color: #a8f0c6;
	}

	.form__msg[data-state='ko'] {
		color: #ff9b8a;
	}

	.form__msg a {
		color: inherit;
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	@media (max-width: 40rem) {
		.form__row {
			grid-template-columns: 1fr;
		}

		.form__foot .b {
			justify-self: stretch;
		}
	}
</style>

<script>
	const form = document.querySelector<HTMLFormElement>('[data-form]');

	if (form) {
		const msg = form.querySelector<HTMLElement>('[data-msg]');
		const button = form.querySelector<HTMLButtonElement>('[data-submit]');
		const key = form.dataset.key ?? '';
		const mail = form.dataset.mail ?? '';
		const SUBJECT = 'Demande de scan de visibilité IA';

		// Le meme message, mis en forme pour un client mail. Sert de repli quand
		// aucune cle n'est configuree, et de session de rattrapage quand l'envoi
		// echoue : le visiteur ne retape rien.
		const mailtoHref = () => {
			const f = new FormData(form);
			const body = [
				`Site : ${f.get('site') ?? ''}`,
				`Secteur : ${f.get('secteur') ?? ''}`,
				`Questions : ${f.get('questions') ?? ''}`,
				`Concurrent : ${f.get('concurrent') ?? ''}`,
				'',
				`Me répondre à : ${f.get('email') ?? ''}`,
			].join(String.fromCharCode(10));

			return (
				`mailto:${mail}?subject=${encodeURIComponent(SUBJECT)}` +
				`&body=${encodeURIComponent(body)}`
			);
		};

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			if (!msg || !button) return;

			// Pas de service configure : on repasse la main au client mail
			if (!key) {
				window.location.href = mailtoHref();
				return;
			}

			msg.replaceChildren();
			msg.removeAttribute('data-state');
			button.disabled = true;

			// Envoi en multipart et non en JSON : une requete simple au sens CORS,
			// donc sans preflight OPTIONS. Un filtre reseau ou un proxy d'entreprise
			// de moins sur le chemin.
			const payload = new FormData(form);
			payload.append('access_key', key);
			payload.append('subject', SUBJECT);
			payload.append('from_name', 'quoted.fr');

			try {
				const response = await fetch('https://api.web3forms.com/submit', {
					method: 'POST',
					body: payload,
				});

				if (!response.ok) throw new Error(String(response.status));

				form.reset();
				msg.dataset.state = 'ok';
				msg.textContent =
					'Bien reçu. Vous avez une réponse sous 48 h ouvrées, avec le relevé.';
			} catch {
				// L'envoi peut echouer pour des raisons qui ne regardent pas le
				// visiteur : reseau filtre, service tiers indisponible. On lui rend
				// son message sous forme de mail pret a partir plutot qu'une impasse.
				const link = document.createElement('a');
				link.href = mailtoHref();
				link.textContent = 'envoyer votre demande par e-mail';

				msg.dataset.state = 'ko';
				msg.replaceChildren(
					document.createTextNode("L'envoi a échoué. Réessayez, ou "),
					link,
					document.createTextNode(" : tout est déjà rempli, il ne reste qu'à cliquer."),
				);
			} finally {
				button.disabled = false;
			}
		});
	}
</script>
