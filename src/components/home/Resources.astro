---
import { getCollection } from 'astro:content';

const guides = (await getCollection('guide', ({ data }) => !data.draft)).sort(
	(a, b) => a.data.order - b.data.order,
);
---

<section class="band" id="ressources">
	<div class="wrap">
		<div class="head obs">
			<p class="kicker">Ressources</p>
			<h2>Notre méthode, <span class="blue">en accès libre</span></h2>
			<p>
				Pas de livre blanc à échanger contre votre adresse e-mail. Si vous préférez
				appliquer la méthode vous-même, elle est écrite.
			</p>
		</div>

		<div class="res">
			{
				guides.map((guide, index) => (
					<a class="res__c obs" href={`/guide/${guide.id}/`} style={`--d: ${index * 60}ms`}>
						<p class="res__k">{guide.data.chapter}</p>
						<h3>{guide.data.title}</h3>
						<p class="res__d">{guide.data.description}</p>
						<span class="res__go">
							Lire <span class="arrow" aria-hidden="true">→</span>
						</span>
					</a>
				))
			}
		</div>

		<a class="b b--line res__all" href="/guide/">Ouvrir le guide</a>
	</div>
</section>

<style>
	.res {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(1rem, 2vw, 1.5rem);
	}

	.res__c {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		padding: clamp(1.35rem, 2.4vw, 1.9rem);
		border-radius: var(--round);
		background: var(--paper-tint);
		text-decoration: none;
		transition: background-color 0.2s ease, transform 0.2s ease;
	}

	.res__c:hover {
		background: var(--blue-wash);
		transform: translateY(-3px);
	}

	.res__k {
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--blue);
	}

	.res__d {
		font-size: var(--s--1);
		line-height: 1.6;
		color: var(--ink-soft);
		flex: 1;
	}

	.res__go {
		font-family: var(--display);
		font-weight: 600;
		color: var(--blue-deep);
	}

	.res__all {
		margin-top: 1.75rem;
	}

	@media (max-width: 66rem) {
		.res {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 40rem) {
		.res {
			grid-template-columns: 1fr;
		}
	}
</style>
