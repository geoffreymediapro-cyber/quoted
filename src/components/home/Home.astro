---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import chatgpt from '../../assets/engines/chatgpt.webp';
import gemini from '../../assets/engines/gemini.webp';
import claude from '../../assets/engines/claude.png';
import googleAi from '../../assets/engines/google-ai.png';
import portrait from '../../assets/consultant.png';
import manucurist from '../../assets/clients/manucurist.png';
import arrago from '../../assets/clients/arrago.png';
import petitsCulottes from '../../assets/clients/petits-culottes.png';
import dermalogica from '../../assets/clients/dermalogica.png';
import {
	EXPERTISES,
	PROCESS,
	CONSULTANT,
	FAQ,
} from '../../data/site';

const guides = (await getCollection('guide', ({ data }) => !data.draft)).sort(
	(a, b) => a.data.order - b.data.order,
);

/**
 * Logos sous la ligne de flottaison.
 * Les fichiers sont detoures et exportes au triple de la taille visee,
 * d'ou le couple width/height ci-dessous qui donne l'affichage reel.
 * Les hauteurs different volontairement : a hauteur egale, un logo carre
 * ecrase un wordmark allonge. Elles sont calees sur une surface egale.
 */
const clientLogos = [
	{ name: 'Manucurist Paris', src: manucurist, w: 116, h: 32 },
	{ name: 'Dermalogica', src: dermalogica, w: 148, h: 18 },
	{ name: 'Arrago', src: arrago, w: 36, h: 47 },
	{ name: 'Les Petits Culottés', src: petitsCulottes, w: 62, h: 46 },
];

const proofs = [
	'Relevé avant toute production',
	'Méthode publiée en accès libre',
	'Périmètre écrit avant le devis',
	'Aucun outil facturé en licence',
];

/**
 * Graphe du hero : taux de presence par moteur.
 * Valeurs ILLUSTRATIVES et signalees comme telles, aucun client reel.
 * ⚠️ Perplexity n'a pas de logo fourni : marque neutre en attendant.
 */
const models = [
	{ name: 'ChatGPT', logo: chatgpt, value: 24 },
	{ name: 'Perplexity', logo: null, value: 40 },
	{ name: 'Gemini', logo: gemini, value: 31 },
	{ name: 'AI Overviews', logo: googleAi, value: 18 },
	{ name: 'Claude', logo: claude, value: 27 },
];

/**
 * Pictogrammes des expertises. Traces a la main pour rester coherents
 * entre eux, plutot que des emojis dont le rendu change selon l'OS.
 */
const ICONS: Record<string, string> = {
	radar: '<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="4"/><circle cx="12" cy="12" r="1.3" fill="currentColor" stroke="none"/>',
	prompt: '<circle cx="10.5" cy="10.5" r="6.4"/><path d="M15.3 15.3 21 21"/><path d="M8.6 9.4a2 2 0 1 1 2.1 2.1v1"/>',
	doc: '<path d="M6 3.5h8l4 4v13H6z"/><path d="M14 3.5v4h4"/><path d="M9 12.5h6M9 16h4"/>',
	nodes: '<circle cx="5.5" cy="6.5" r="2.2"/><circle cx="18.5" cy="9.5" r="2.2"/><circle cx="10" cy="18" r="2.2"/><path d="M7.6 7.2 16.4 9M17 11.5l-5.4 5M8.9 15.9 6.3 8.7"/>',
	gear: '<path d="M8.4 7.4 3.6 12l4.8 4.6M15.6 7.4 20.4 12l-4.8 4.6M13.6 4.6l-3.2 14.8"/>',
	pen: '<path d="M4 20.5l1.1-4.2L16.6 4.8a2.2 2.2 0 0 1 3.1 3.1L8.2 19.4z"/><path d="M14.6 6.8l3.1 3.1"/>',
	link: '<path d="M10.2 14.2a4.2 4.2 0 0 0 6 0l2.6-2.6a4.2 4.2 0 0 0-6-6L11.5 6.9"/><path d="M13.8 10.2a4.2 4.2 0 0 0-6 0l-2.6 2.6a4.2 4.2 0 0 0 6 6l1.3-1.3"/>',
	chat: '<path d="M3.5 4.5h17v10h-10l-4.5 3.5V14.5h-2.5z"/><circle cx="8.5" cy="9.5" r="1" fill="currentColor" stroke="none"/><circle cx="12" cy="9.5" r="1" fill="currentColor" stroke="none"/><circle cx="15.5" cy="9.5" r="1" fill="currentColor" stroke="none"/>',
	book: '<path d="M3.5 4.5h6a3 3 0 0 1 3 3v12a2.4 2.4 0 0 0-2.4-2.4H3.5z"/><path d="M20.5 4.5h-6a3 3 0 0 0-3 3v12a2.4 2.4 0 0 1 2.4-2.4h6.6z"/>',
	chart: '<path d="M3.5 20.5h17"/><path d="M6.5 17.5v-6M11.5 17.5V7M16.5 17.5v-4"/>',
};

/** Une teinte pastel par carte, seul ilot de couleur de la page. */
const TINTS = [
	['#efe9ff', '#e2d7ff'],
	['#dff3ec', '#ccebdf'],
	['#ffe8dc', '#ffd9c4'],
	['#e1ecff', '#cfe0ff'],
	['#fff3cf', '#ffe9ab'],
	['#ffe3ee', '#ffd0e2'],
	['#e7f2db', '#d7ebc2'],
	['#f7eada', '#efdcc1'],
	['#e4e6fc', '#d3d7fa'],
	['#dceff6', '#c6e4f0'],
];

---

<!-- ===================== HERO ===================== -->
<section class="hero">
	<div class="hero__blob" aria-hidden="true"></div>

	<div class="wrap hero__grid">
		<div>
			<p class="kick up">Agence GEO · Generative Engine Optimization</p>

			<h1 class="up" style="--d: 60ms">
				Vos clients demandent.<br />
				<span class="hi">L'IA répond.</span><br />
				Elle cite qui ?
			</h1>

			<p class="hero__lede up" style="--d: 120ms">
				ChatGPT, Perplexity, Gemini, Claude, AI Overviews : sur ces surfaces, il ne reste que
				trois ou quatre sources à l'écran. Nous travaillons votre place parmi elles, et
				nous la mesurons chaque mois.
			</p>

			<div class="hero__act up" style="--d: 180ms">
				<a class="b b--go" href="#contact">
					Scanner ma visibilité IA
					<span class="arw" aria-hidden="true">→</span>
				</a>
				<a class="b b--line" href="#expertises">Nos expertises</a>
			</div>
		</div>

		<div class="hero__vis up" style="--d: 260ms">
			<figure class="ask">
				<span class="ask__dot" aria-hidden="true"></span>
				Quel logiciel de facturation pour une TPE en 2026 ?
			</figure>

			<figure class="chart">
				<div class="chart__bar">
					<span>Taux de présence par moteur</span>
					<span class="chart__tag">Illustration</span>
				</div>

				<div class="chart__in">
					<div class="serie__plot">
						<div class="serie__ax" aria-hidden="true">
							<span>50 %</span>
							<span>25 %</span>
							<span>0</span>
						</div>

						<div class="serie__bars">
							{
								models.map((model) => (
									<div class="bar">
										<span class="bar__v">{model.value}%</span>
										{/* axe cale sur 50 % : la hauteur vaut le double de la valeur */}
										<span class="bar__col" style={`--h: ${model.value * 2}%`} />
									</div>
								))
							}
						</div>

						<div class="serie__names">
							{
								models.map((model) => (
									<span class="eng">
										{model.logo ? (
											<Image src={model.logo} alt="" width={20} height={20} loading="eager" />
										) : (
											<span class="eng__na" aria-hidden="true">
												P
											</span>
										)}
										{model.name}
									</span>
								))
							}
						</div>
					</div>

					<p class="serie__n">
						Part des réponses où la marque est mentionnée, relevée sur les cinq moteurs.
					</p>
				</div>
			</figure>
		</div>
	</div>
</section>

<!-- ===================== LOGOS CLIENTS ===================== -->
<section class="marks">
	<div class="wrap marks__in">
		<p class="marks__k">Marques accompagnées</p>
		<ul class="marks__row">
			{
				clientLogos.map((logo) => (
					<li>
						<Image
							src={logo.src}
							alt={logo.name}
							width={logo.w}
							height={logo.h}
							densities={[1, 2]}
							loading="eager"
						/>
					</li>
				))
			}
		</ul>
	</div>
</section>

<!-- ===================== BARRE DE PREUVE ===================== -->
<div class="proof">
	<div class="wrap proof__in">
		{proofs.map((proof) => <span>{proof}</span>)}
	</div>
</div>

<!-- ===================== EXPERTISES ===================== -->
<section class="band" id="expertises">
	<div class="wrap">
		<div class="head obs">
			<p class="kick">Nos expertises</p>
			<h2>Le GEO d'abord, <span class="hi">le SEO avec</span></h2>
			<p>
				Être cité par une IA suppose d'être trouvable tout court. Nous travaillons les
				deux, et nous disons lequel des deux compte le plus dans votre cas.
			</p>
		</div>

		<ul class="exp">
			{
				EXPERTISES.map((item, index) => (
					<li
						class="exp__c obs"
						style={`--a: ${TINTS[index % TINTS.length][0]}; --b: ${TINTS[index % TINTS.length][1]}; --d: ${index * 35}ms`}
					>
						<span class="exp__i" aria-hidden="true">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[item.icon]} />
						</span>
						<div class="exp__h">
							<h3>{item.name}</h3>
							{item.core && <span class="exp__t">GEO</span>}
							{item.via && <span class="exp__t exp__t--via">{item.via}</span>}
						</div>
						<p>{item.note}</p>
					</li>
				))
			}

			<li class="exp__c exp__c--cta obs" style={`--d: ${EXPERTISES.length * 35}ms`}>
				<a href="#contact">
					<span class="exp__go" aria-hidden="true">↗</span>
					<h3>Scanner ma visibilité IA</h3>
					<p>Relevé gratuit sur cinq prompts de votre marché, réponse sous 48 h.</p>
				</a>
			</li>
		</ul>
	</div>
</section>

<!-- ===================== PROCESS ===================== -->
<section class="band band--soft" id="methode">
	<div class="wrap">
		<div class="head obs">
			<p class="kick">Méthode</p>
			<h2>Comment on <span class="hi">travaille avec vous</span></h2>
			<p>Un process en quatre étapes, du premier relevé au reporting mensuel.</p>
		</div>

		{/* Onglets en CSS pur : chaque radio affiche son panneau. */}
		<div class="proc obs">
			<div class="proc__tabs" role="group" aria-label="Étape affichée">
				{
					PROCESS.map((step, index) => (
						<>
							<input
								type="radio"
								name="step"
								id={`s-${step.id}`}
								class="proc__radio sr"
								checked={index === 0}
							/>
							<label for={`s-${step.id}`}>
								<span>{String(index + 1).padStart(2, '0')}</span>
								{step.tab}
							</label>
						</>
					))
				}
			</div>

			<div class="proc__panels">
				{
					PROCESS.map((step, index) => (
						<div class={`panel panel--${step.id}`}>
							<div class="panel__txt">
								<h3>{step.title}</h3>
								<p>{step.body}</p>
								<ul class="ticks">
									{step.points.map((point) => (
										<li>{point}</li>
									))}
								</ul>
							</div>

							<div class="panel__side">
								<span class="panel__n" aria-hidden="true">
									{String(index + 1).padStart(2, '0')}
								</span>
								<span class="panel__when">{step.when}</span>
							</div>
						</div>
					))
				}
			</div>
		</div>
	</div>
</section>

<!-- ===================== RESSOURCES ===================== -->
<section class="band" id="ressources">
	<div class="wrap">
		<div class="head obs">
			<p class="kick">Ressources</p>
			<h2>Tout ce qu'on sait, <span class="hi">en accès libre</span></h2>
		</div>

		<div class="gui">
			{
				guides.map((guide, index) => (
					<a class="gui__c obs" href={`/guide/${guide.id}/`} style={`--d: ${index * 50}ms`}>
						<p class="gui__k">{guide.data.chapter}</p>
						<h3>{guide.data.title}</h3>
						<span class="gui__go">
							Lire <span class="arw" aria-hidden="true">→</span>
						</span>
					</a>
				))
			}
		</div>
	</div>
</section>

<!-- ===================== CONSULTANT ===================== -->
<section class="band band--soft" id="consultant">
	<div class="wrap who">
		<figure class="who__ph obs">
			<Image
				src={portrait}
				alt={`${CONSULTANT.name}, ${CONSULTANT.role}`}
				widths={[320, 480, 640]}
				sizes="(max-width: 56rem) 60vw, 20rem"
			/>
		</figure>

		<div class="obs" style="--d: 90ms">
			<p class="kick">Derrière Quoted</p>
			<h2>Vous parlez à la personne <span class="hi">qui exécute</span></h2>
			<p class="lede who__p">
				Pas de commercial qui vend puis disparaît, pas de dossier repassé à un junior
				après la signature. La personne qui relève vos prompts est celle qui écrit vos
				contenus et qui vous présente le reporting.
			</p>

			<ul class="ticks who__l">
				{CONSULTANT.points.map((point) => <li>{point}</li>)}
			</ul>

			<p class="who__id">
				<strong>{CONSULTANT.name}</strong>
				<span>{CONSULTANT.role}</span>
			</p>
		</div>
	</div>
</section>

<!-- ===================== FAQ ===================== -->
<section class="band" id="faq">
	<div class="wrap">
		<div class="head obs">
			<p class="kick">Questions fréquentes</p>
			<h2>Ce qu'on nous demande <span class="hi">avant de signer</span></h2>
		</div>

		<div class="faq">
			{
				FAQ.map((item, index) => (
					<details class="qa obs" style={`--d: ${index * 30}ms`} name="faq">
						<summary>
							<span>{item.q}</span>
							<span class="qa__s" aria-hidden="true" />
						</summary>
						<div class="qa__a">
							<p>{item.a}</p>
						</div>
					</details>
				))
			}
		</div>
	</div>
</section>

<!-- ===================== CONTACT ===================== -->
<section class="band band--dark" id="contact">
	<div class="wrap fin on-dark">
		<div>
			<p class="kick obs">Le scan</p>
			<h2 class="obs" style="--d: 60ms">
				Voyons d'abord ce que l'IA <span class="hi">dit déjà</span> de vous
			</h2>
			<p class="fin__p obs" style="--d: 120ms">
				Envoyez-nous votre site, votre secteur et deux ou trois questions que vos
				clients posent avant d'acheter. Nous rejouons ces questions sur les moteurs et
				nous vous renvoyons ce qu'ils répondent, et qui ils citent.
			</p>
			<div class="fin__act obs" style="--d: 180ms">
				<a class="b b--go" href="/scan/">
					Scanner ma visibilité IA
					<span class="arw" aria-hidden="true">→</span>
				</a>
			</div>
		</div>

		<div class="fin__box obs" style="--d: 240ms">
			<p class="fin__bt">Ce que contient le scan</p>
			<ul class="ticks">
				<li>Cinq prompts de votre marché rejoués sur cinq moteurs</li>
				<li>Ce qui ressort, et les sources citées à chaque fois</li>
				<li>Si votre marque apparaît, et à quelle place</li>
				<li>Les deux ou trois écarts les plus évidents</li>
			</ul>
			<p class="fin__bn">
				Gratuit, sans engagement, et sans relance automatique derrière. Réponse sous
				48 h ouvrées. Ce n'est pas un audit complet : c'est un aperçu honnête pour
				savoir s'il y a matière à travailler.
			</p>
		</div>
	</div>
</section>

<style>
	/* ================= HERO ================= */
	.hero {
		position: relative;
		padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(2.5rem, 5vw, 4rem);
		overflow: hidden;
	}

	.hero__blob {
		position: absolute;
		top: -18%;
		right: -14%;
		width: 62%;
		height: 132%;
		background: var(--surface);
		border-radius: 46% 54% 40% 60% / 52% 44% 56% 48%;
		pointer-events: none;
	}

	.hero__grid {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1.02fr) minmax(0, 0.98fr);
		gap: clamp(2rem, 5vw, 3.5rem);
		align-items: center;
	}

	.hero h1 {
		font-size: var(--s-4);
	}

	.hero__lede {
		margin-block: 1.4rem 2rem;
		font-size: var(--s-1);
		line-height: 1.55;
		color: var(--ink-soft);
		max-width: 38ch;
	}

	.hero__act {
		display: flex;
		flex-wrap: wrap;
		gap: 0.7rem;
	}

	.hero__vis {
		position: relative;
		padding-top: 4.25rem;
	}

	.ask {
		position: absolute;
		top: 0;
		left: -3rem;
		z-index: 2;
		display: flex;
		align-items: center;
		gap: 0.6rem;
		max-width: 28rem;
		padding: 0.8rem 1.2rem;
		background: var(--accent);
		color: #fff;
		border-radius: 999px;
		font-size: 0.82rem;
		font-weight: 700;
		line-height: 1.3;
		box-shadow: var(--shadow);
	}

	.ask__dot {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: #fff;
		opacity: 0.7;
		flex: none;
	}

	/* ---- Graphe : visibilite par moteur ---- */
	.chart {
		background: var(--paper);
		border: 1px solid var(--line);
		border-radius: var(--round);
		box-shadow: var(--shadow);
		overflow: hidden;
	}

	.chart__in {
		padding: clamp(1.1rem, 2.4vw, 1.6rem);
	}

	/* Grille : axe des ordonnees a gauche, barres a droite, noms dessous */
	.serie__plot {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		column-gap: 0.7rem;
		row-gap: 0.55rem;
	}

	.serie__ax {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		height: 11.5rem;
		font-size: 0.62rem;
		font-weight: 600;
		color: var(--ink-mute);
		text-align: right;
	}

	/* Les libelles sont cales sur la ligne de niveau correspondante */
	.serie__ax span {
		transform: translateY(-0.4em);
	}

	.serie__ax span:last-child {
		transform: translateY(0.1em);
	}

	.serie__bars {
		display: flex;
		align-items: flex-end;
		gap: clamp(0.5rem, 2vw, 1.1rem);
		height: 11.5rem;
		/* Lignes de niveau a 0, 25 et 50 % */
		background-image: repeating-linear-gradient(
			to top,
			var(--line) 0 1px,
			transparent 1px 50%
		);
	}

	.serie__names {
		grid-column: 2;
		display: flex;
		gap: clamp(0.5rem, 2vw, 1.1rem);
	}

	.eng {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.3rem;
		font-size: 0.68rem;
		font-weight: 600;
		color: var(--ink-mute);
		text-align: center;
		line-height: 1.2;
	}

	.eng :global(img) {
		width: 1.15rem;
		height: 1.15rem;
		object-fit: contain;
	}

	/* Marque neutre tant que le logo Perplexity n'est pas fourni */
	.eng__na {
		display: grid;
		place-items: center;
		width: 1.15rem;
		height: 1.15rem;
		border-radius: 50%;
		background: var(--accent-wash);
		color: var(--accent);
		font-size: 0.6rem;
		font-weight: 800;
	}

	.bar {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		align-items: center;
		height: 100%;
	}

	.bar__v {
		font-family: var(--display);
		font-size: 0.78rem;
		font-weight: 800;
		color: var(--ink);
		margin-bottom: 0.3rem;
	}

	.bar__col {
		width: 100%;
		max-width: 3rem;
		height: var(--h);
		border-radius: 7px 7px 0 0;
		background: linear-gradient(to top, var(--accent), color-mix(in srgb, var(--accent) 55%, #fff));
		transform-origin: bottom;
		animation: grow 0.7s cubic-bezier(0.16, 1, 0.3, 1) backwards;
	}

	.bar:nth-child(2) .bar__col {
		animation-delay: 80ms;
	}

	.bar:nth-child(3) .bar__col {
		animation-delay: 160ms;
	}

	.bar:nth-child(4) .bar__col {
		animation-delay: 240ms;
	}

	@keyframes grow {
		from {
			transform: scaleY(0);
		}
	}

	.serie__n {
		margin-top: 1.4rem;
		padding-top: 0.9rem;
		border-top: 1px solid var(--line);
		font-size: 0.74rem;
		line-height: 1.5;
		color: var(--ink-mute);
	}

	@media (prefers-reduced-motion: reduce) {
		.bar__col {
			animation: none;
		}
	}

	.chart__bar {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.85rem 1.2rem;
		background: var(--dark);
		color: #fff;
		font-size: 0.72rem;
