---
import { FAQ } from '../../data/site';
---

<section class="band band--tint" id="faq">
	<div class="wrap">
		<div class="head obs">
			<p class="kicker">Questions fréquentes</p>
			<h2>Ce qu'on nous demande <span class="hl">avant</span> de signer</h2>
		</div>

		<div class="faq">
			{
				FAQ.map((item, index) => (
					<details class="qa obs" style={`--d: ${index * 40}ms`} name="faq">
						<summary>
							<span class="qa__q">{item.q}</span>
							<span class="qa__s" aria-hidden="true" />
						</summary>
						<div class="qa__a">
							<p>{item.a}</p>
						</div>
					</details>
				))
			}
		</div>
	</div>
</section>

<style>
	.faq {
		max-width: 58rem;
		display: grid;
		gap: 0.65rem;
	}

	.qa {
		background: var(--paper);
		border: 1px solid var(--line);
		border-radius: var(--round-sm);
		transition: border-color 0.18s ease;
	}

	.qa[open] {
		border-color: var(--line-strong);
	}

	summary {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1.5rem;
		padding: 1.15rem 1.35rem;
		cursor: pointer;
		list-style: none;
		transition: color 0.16s ease;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	summary:hover {
		color: var(--blue);
	}

	.qa__q {
		font-family: var(--display);
		font-size: var(--s-1);
		font-weight: 600;
		line-height: 1.25;
		letter-spacing: -0.025em;
	}

	/* Croix qui pivote en moins a l'ouverture */
	.qa__s {
		position: relative;
		flex: none;
		width: 1.1rem;
		height: 1.1rem;
		margin-top: 0.3rem;
	}

	.qa__s::before,
	.qa__s::after {
		content: '';
		position: absolute;
		inset: 50% 0 auto 0;
		height: 2px;
		border-radius: 2px;
		background: var(--blue);
		transition: transform 0.26s cubic-bezier(0.2, 0.8, 0.3, 1);
	}

	.qa__s::after {
		transform: rotate(90deg);
	}

	.qa[open] .qa__s::after {
		transform: rotate(0deg);
	}

	.qa__a {
		padding: 0 1.35rem 1.35rem;
		max-width: var(--measure);
		animation: unfold 0.3s ease;
	}

	.qa__a p {
		font-size: var(--s--1);
		line-height: 1.7;
		color: var(--ink-soft);
	}

	@keyframes unfold {
		from {
			opacity: 0;
			transform: translateY(-4px);
		}
	}
</style>
