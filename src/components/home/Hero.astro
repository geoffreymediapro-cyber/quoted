---
import { Image } from 'astro:assets';

/**
 * Si une vraie capture existe dans src/assets/hero-answer.(png|jpg|webp),
 * elle remplace l'illustration. Mode d'emploi : src/assets/README.md.
 */
const found = import.meta.glob<{ default: ImageMetadata }>(
	'../../assets/hero-answer.{png,jpg,jpeg,webp,avif}',
	{ eager: true },
);
const screenshot = Object.values(found)[0]?.default;

const proofs = ['Relevé avant production', 'Périmètre écrit', 'Sans engagement de durée'];

const sources = [
	{ n: 1, label: 'votre-marque.fr', kind: 'Site de la marque', on: true },
	{ n: 2, label: 'guide-comparatif.fr', kind: 'Média spécialisé' },
	{ n: 3, label: 'reddit.com / r/…', kind: 'Discussion' },
];
---

<section class="hero">
	<div class="wrap hero__grid">
		<div>
			<p class="kicker up">Agence GEO · Generative Engine Optimization</p>

			<h1 class="up" style="--d: 60ms">
				L'agence qui fait <span class="hl">citer votre marque</span> par les IA
			</h1>

			<p class="hero__lede up" style="--d: 120ms">
				Vos prospects posent désormais leurs questions à ChatGPT, Perplexity ou Gemini,
				et repartent avec une réponse rédigée accompagnée de trois ou quatre sources.
				Nous travaillons votre place dans cette réponse.
			</p>

			<div class="hero__act up" style="--d: 180ms">
				<a class="b b--fill" href="#contact">
					Parler de votre visibilité
					<span class="arrow" aria-hidden="true">→</span>
				</a>
				<a class="b b--line" href="#services">Voir nos services</a>
			</div>

			<ul class="hero__pts up" style="--d: 240ms">
				{proofs.map((proof) => <li>{proof}</li>)}
			</ul>
		</div>

		{
			screenshot ? (
				<figure class="shot up" style="--d: 300ms">
					<Image
						src={screenshot}
						alt="Réponse générée par un moteur d'IA affichant la liste des sources qu'il cite."
						widths={[560, 840, 1120]}
						sizes="(max-width: 62rem) 92vw, 38rem"
						loading="eager"
					/>
				</figure>
			) : (
				<figure class="card up" style="--d: 300ms">
					<div class="card__bar">
						<span class="card__label">Réponse générée</span>
						<span class="card__tag">Illustration</span>
					</div>
					<div class="card__in">
						<p class="card__q">Quel logiciel de facturation pour une TPE en 2026 ?</p>
						<p class="card__a">
							Trois solutions reviennent régulièrement sur ce besoin.
							<mark>Votre marque</mark>
							<sup>1</sup> est citée pour sa conformité à la facturation
							électronique<sup>2</sup> et la qualité de son support<sup>3</sup>.
						</p>
						<p class="card__st">Sources citées</p>
						<ul class="card__src">
							{sources.map((source) => (
								<li class:list={[{ on: source.on }]}>
									<span class="card__n">{source.n}</span>
									<span class="card__d">{source.label}</span>
									<span class="card__k">{source.kind}</span>
								</li>
							))}
						</ul>
					</div>
				</figure>
			)
		}
	</div>
</section>

<style>
	.hero {
		padding-block: clamp(2.5rem, 6vw, 5rem) clamp(3rem, 6vw, 5.5rem);
		background:
			radial-gradient(60% 70% at 85% 0%, var(--blue-wash), transparent 70%),
			var(--paper);
	}

	.hero__grid {
		display: grid;
		grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
		gap: clamp(2rem, 5vw, 4rem);
		align-items: center;
	}

	.hero__lede {
		margin-block: 1.35rem 2rem;
		font-size: var(--s-1);
		line-height: 1.55;
		color: var(--ink-soft);
		max-width: 40ch;
	}

	.hero__act {
		display: flex;
		flex-wrap: wrap;
		gap: 0.7rem;
		margin-bottom: 2rem;
	}

	.hero__pts {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		list-style: none;
		padding: 0;
		font-size: var(--s--1);
		font-weight: 600;
		color: var(--ink-mute);
	}

	.hero__pts li {
		display: flex;
		align-items: center;
		gap: 0.45rem;
	}

	.hero__pts li::before {
		content: '';
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: var(--lemon);
		box-shadow: 0 0 0 3px var(--blue-wash);
	}

	/* --- Capture reelle --- */
	.shot {
		border-radius: var(--round);
		overflow: hidden;
		box-shadow: var(--shadow);
		border: 1px solid var(--line);
	}

	.shot :global(img) {
		width: 100%;
		height: auto;
	}

	/* --- Illustration --- */
	.card {
		background: var(--paper);
		border-radius: var(--round);
		box-shadow: var(--shadow);
		overflow: hidden;
		border: 1px solid var(--line);
	}

	.card__bar {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.8rem 1.1rem;
		background: var(--navy);
		color: #fff;
	}

	.card__label {
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.card__tag {
		margin-left: auto;
		font-size: 0.66rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: rgba(234, 240, 251, 0.6);
		border: 1px solid rgba(234, 240, 251, 0.28);
		border-radius: 999px;
		padding: 0.15rem 0.55rem;
	}

	.card__in {
		padding: clamp(1.2rem, 2.5vw, 1.7rem);
	}

	.card__q {
		font-family: var(--display);
		font-size: var(--s-1);
		font-weight: 600;
		letter-spacing: -0.02em;
		padding-bottom: 0.9rem;
		margin-bottom: 1rem;
		border-bottom: 1px solid var(--line);
	}

	.card__a {
		font-size: var(--s--1);
		line-height: 1.7;
		color: var(--ink-soft);
		margin-bottom: 1.3rem;
	}

	.card__a mark {
		background: var(--lemon);
		color: var(--navy);
		font-weight: 700;
		padding: 0 0.2em;
		border-radius: 3px;
	}

	.card__a sup {
		color: var(--blue);
		font-weight: 700;
		font-size: 0.7em;
	}

	.card__st {
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--ink-mute);
		margin-bottom: 0.6rem;
	}

	.card__src {
		list-style: none;
		padding: 0;
		display: grid;
		gap: 0.4rem;
	}

	.card__src li {
		display: grid;
		grid-template-columns: 1.4rem 1fr auto;
		gap: 0.7rem;
		align-items: center;
		padding: 0.55rem 0.7rem;
		border-radius: var(--round-sm);
		background: var(--paper-tint);
		font-size: 0.82rem;
	}

	.card__src li.on {
		background: var(--blue-wash);
	}

	.card__n {
		display: grid;
		place-items: center;
		width: 1.4rem;
		height: 1.4rem;
		border-radius: 50%;
		background: #fff;
		color: var(--ink-mute);
		font-size: 0.68rem;
		font-weight: 700;
	}

	.card__src li.on .card__n {
		background: var(--blue);
		color: #fff;
	}

	.card__d {
		color: var(--ink-soft);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.card__src li.on .card__d {
		color: var(--blue-deep);
		font-weight: 700;
	}

	.card__k {
		font-size: 0.68rem;
		color: var(--ink-mute);
		white-space: nowrap;
	}

	@media (max-width: 62rem) {
		.hero__grid {
			grid-template-columns: 1fr;
		}

		.hero__lede {
			max-width: 48ch;
		}
	}

	@media (max-width: 26rem) {
		.card__src li {
			grid-template-columns: 1.4rem 1fr;
		}

		.card__k {
			display: none;
		}
	}
</style>
