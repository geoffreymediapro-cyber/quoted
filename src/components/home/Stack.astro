---
import { TOOLS } from '../../data/site';
---

<section class="band" id="outils">
	<div class="wrap">
		<div class="head obs">
			<p class="kicker">Nos outils</p>
			<h2>Les outils du relevé, <span class="blue">rien de propriétaire</span></h2>
			<p>
				Aucune licence maison à vous refacturer. Ce sont les mêmes instruments que
				n'importe qui peut ouvrir : ce qui change, c'est le protocole appliqué dessus,
				et la régularité avec laquelle il est rejoué.
			</p>
		</div>

		<ul class="tools">
			{
				TOOLS.map((tool, index) => (
					<li class="tool obs" style={`--d: ${index * 35}ms`}>
						<span class="tool__code" aria-hidden="true">
							{tool.code}
						</span>
						<span class="tool__body">
							<span class="tool__name">{tool.name}</span>
							<span class="tool__use">{tool.use}</span>
						</span>
					</li>
				))
			}
		</ul>

		<p class="tools__note obs">
			Les moteurs sont interrogés dans des conditions comparables d'un relevé à l'autre,
			et la version constatée est consignée à chaque campagne, sans quoi deux mesures ne
			se comparent pas.
		</p>
	</div>
</section>

<style>
	.tools {
		list-style: none;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.75rem;
	}

	.tool {
		display: flex;
		align-items: center;
		gap: 0.8rem;
		padding: 0.85rem 1rem;
		border-radius: var(--round-sm);
		background: var(--paper-tint);
		transition: background-color 0.18s ease, transform 0.18s ease;
	}

	.tool:hover {
		background: var(--blue-wash);
		transform: translateY(-2px);
	}

	.tool__code {
		display: grid;
		place-items: center;
		flex: none;
		width: 2.4rem;
		height: 2.4rem;
		border-radius: 8px;
		background: var(--navy);
		color: #fff;
		font-family: var(--display);
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.02em;
		transition: background-color 0.18s ease;
	}

	.tool:hover .tool__code {
		background: var(--blue);
	}

	.tool__body {
		display: grid;
		gap: 0.1rem;
		min-width: 0;
	}

	.tool__name {
		font-family: var(--display);
		font-size: var(--s--1);
		font-weight: 600;
		letter-spacing: -0.02em;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.tool__use {
		font-size: 0.72rem;
		color: var(--ink-mute);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.tools__note {
		margin-top: 1.75rem;
		padding-left: 1.1rem;
		border-left: 4px solid var(--lemon);
		max-width: var(--measure);
		font-size: var(--s--1);
		color: var(--ink-soft);
	}

	@media (max-width: 68rem) {
		.tools {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (max-width: 46rem) {
		.tools {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 30rem) {
		.tools {
			grid-template-columns: 1fr;
		}
	}
</style>
