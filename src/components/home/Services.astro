---
import { SERVICES } from '../../data/site';
---

<section class="band band--tint" id="services">
	<div class="wrap">
		<div class="head obs">
			<p class="kicker">Nos services</p>
			<h2>Six leviers pour devenir une <span class="hl">source citée</span></h2>
			<p>
				Chacun se travaille seul ou dans un même mouvement, selon ce que révèle l'état
				des lieux.
			</p>
		</div>

		<div class="srv">
			{
				SERVICES.map((service, index) => (
					<article class="srv__c obs" style={`--d: ${index * 50}ms`}>
						<p class="srv__k">{service.kicker}</p>
						<h3>{service.name}</h3>
						<p class="srv__d">{service.description}</p>
						<ul class="dots srv__l">
							{service.features.map((feature) => (
								<li>{feature}</li>
							))}
						</ul>
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	.srv {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(1rem, 2vw, 1.5rem);
	}

	.srv__c {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		padding: clamp(1.35rem, 2.4vw, 1.9rem);
		background: var(--paper);
		border-radius: var(--round);
		border: 1px solid var(--line);
		transition: box-shadow 0.2s ease, transform 0.2s ease;
	}

	.srv__c:hover {
		box-shadow: var(--shadow);
		transform: translateY(-3px);
	}

	.srv__k {
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--blue);
	}

	.srv__d {
		font-size: var(--s--1);
		line-height: 1.6;
		color: var(--ink-soft);
		flex: 1;
	}

	.srv__l {
		padding-top: 0.85rem;
		border-top: 1px solid var(--line);
	}

	@media (max-width: 66rem) {
		.srv {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 40rem) {
		.srv {
			grid-template-columns: 1fr;
		}
	}
</style>
