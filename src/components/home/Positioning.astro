---
import { TOOLS } from '../../data/site';
---

<section class="band band--navy">
	<div class="wrap only">
		<h2 class="obs">On ne fait que ça.</h2>
		<p class="obs" style="--d: 80ms">
			Pas de refonte, pas de campagnes payantes, pas de rédaction au kilomètre. Une
			seule question nous occupe : pourquoi un moteur de réponse cite une source plutôt
			qu'une autre, et comment faire pour que ce soit la vôtre.
		</p>
		<div class="only__chips obs" style="--d: 160ms">
			{TOOLS.slice(0, 6).map((tool) => <span>{tool.name}</span>)}
		</div>
	</div>
</section>

<style>
	.only {
		text-align: center;
		display: grid;
		justify-items: center;
		gap: 1.25rem;
	}

	.only h2 {
		font-size: var(--s-4);
	}

	.only > p {
		max-width: 58ch;
		font-size: var(--s-1);
		line-height: 1.55;
		color: rgba(234, 240, 251, 0.75);
	}

	.only__chips {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem;
		margin-top: 0.75rem;
	}

	.only__chips span {
		padding: 0.4rem 0.9rem;
		border-radius: 999px;
		border: 1px solid rgba(234, 240, 251, 0.22);
		font-size: var(--s--1);
		font-weight: 600;
		color: rgba(234, 240, 251, 0.85);
	}
</style>
