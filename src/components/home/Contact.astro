---
import { CONTACT_EMAIL } from '../../data/site';

const subject = encodeURIComponent('Demande de diagnostic GEO');
const body = encodeURIComponent(
	`Bonjour,

Notre site :
Notre secteur :
Ce qu'on cherche à obtenir :
Un ou deux concurrents de référence :

Merci,`,
);

const steps = [
	{
		strong: 'Vous écrivez.',
		rest: 'Votre site, votre secteur, ce que vous cherchez à obtenir.',
	},
	{
		strong: 'Réponse sous 48 h ouvrées.',
		rest: "Une première lecture de votre situation, et la mission qui correspond, y compris si ce n'est pas la nôtre.",
	},
	{
		strong: 'On cadre ensemble.',
		rest: 'Un échange, puis un devis chiffré avec un périmètre écrit. Rien ne démarre avant votre accord.',
	},
];
---

<section class="band band--navy" id="contact">
	<div class="wrap fin">
		<div>
			<p class="kicker obs">Contact</p>
			<h2 class="obs" style="--d: 60ms">
				Voyons d'abord ce que l'IA dit <span class="hl">déjà</span> de vous
			</h2>
			<p class="fin__p obs" style="--d: 120ms">
				Décrivez votre situation en quelques lignes. Vous recevrez une première lecture
				et la mission qui correspond, sans relance commerciale automatique derrière.
			</p>
			<div class="fin__act obs" style="--d: 180ms">
				<a class="b b--lemon" href={`mailto:${CONTACT_EMAIL}?subject=${subject}&body=${body}`}>
					Écrire à Quoted
					<span class="arrow" aria-hidden="true">→</span>
				</a>
				<a class="b b--line" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
			</div>
		</div>

		<ol class="fin__steps obs" style="--d: 240ms">
			{
				steps.map((step) => (
					<li>
						<span>
							<strong>{step.strong}</strong> {step.rest}
						</span>
					</li>
				))
			}
		</ol>
	</div>
</section>

<style>
	.fin {
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
		gap: clamp(2rem, 5vw, 4rem);
		align-items: center;
	}

	.fin__p {
		margin-block: 1.2rem 1.9rem;
		font-size: var(--s-1);
		line-height: 1.55;
		color: rgba(234, 240, 251, 0.75);
		max-width: 46ch;
	}

	.fin__act {
		display: flex;
		flex-wrap: wrap;
		gap: 0.7rem;
	}

	.fin__steps {
		list-style: none;
		padding: 0;
		display: grid;
		gap: 0.75rem;
		counter-reset: f;
	}

	.fin__steps li {
		counter-increment: f;
		display: grid;
		grid-template-columns: 2rem 1fr;
		gap: 0.85rem;
		align-items: baseline;
		padding: 1.05rem 1.25rem;
		border-radius: var(--round-sm);
		background: rgba(234, 240, 251, 0.07);
		font-size: var(--s--1);
		line-height: 1.55;
	}

	.fin__steps li::before {
		content: '0' counter(f);
		font-family: var(--display);
		font-weight: 700;
		color: var(--lemon);
	}

	.fin__steps strong {
		color: #fff;
	}

	@media (max-width: 62rem) {
		.fin {
			grid-template-columns: 1fr;
		}
	}
</style>
