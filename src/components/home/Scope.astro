---
import { SCOPE_IN, SCOPE_OUT } from '../../data/site';
---

<section class="band" id="perimetre">
	<div class="wrap">
		<div class="head obs">
			<p class="kicker">Périmètre</p>
			<h2>Ce qu'on fait, et ce qu'on <span class="blue">refuse de faire</span></h2>
			<p>
				Un périmètre flou finit toujours par se payer, d'un côté ou de l'autre. Autant
				l'écrire avant le devis.
			</p>
		</div>

		<div class="scope">
			<div class="scope__in obs">
				<h3>Dans le périmètre</h3>
				<ul class="dots">
					{SCOPE_IN.map((item) => <li>{item}</li>)}
				</ul>
			</div>

			<div class="scope__out obs" style="--d: 90ms">
				<h3>Hors périmètre</h3>
				<ul>
					{
						SCOPE_OUT.map((item) => (
							<li>
								<p class="scope__label">
									<span class="scope__x" aria-hidden="true">
										✕
									</span>
									{item.label}
								</p>
								<p class="scope__detail">{item.detail}</p>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</div>
</section>

<style>
	.scope {
		display: grid;
		grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
		gap: clamp(1.25rem, 3vw, 2rem);
		align-items: start;
	}

	.scope__in,
	.scope__out {
		padding: clamp(1.4rem, 2.6vw, 2rem);
		border-radius: var(--round);
	}

	.scope__in {
		background: var(--paper-tint);
	}

	.scope__out {
		background: var(--navy);
		color: rgba(234, 240, 251, 0.75);
	}

	.scope h3 {
		margin-bottom: 1.25rem;
		padding-bottom: 0.9rem;
		border-bottom: 1px solid var(--line);
	}

	.scope__out h3 {
		color: #fff;
		border-bottom-color: rgba(234, 240, 251, 0.18);
	}

	.scope__in :global(.dots) {
		font-size: var(--s--1);
	}

	.scope__out ul {
		list-style: none;
		padding: 0;
		display: grid;
		gap: 1.3rem;
	}

	.scope__label {
		display: flex;
		align-items: baseline;
		gap: 0.6rem;
		font-family: var(--display);
		font-weight: 600;
		font-size: var(--s-0);
		letter-spacing: -0.02em;
		color: #fff;
		margin-bottom: 0.3rem;
	}

	.scope__x {
		color: var(--lemon);
		font-size: 0.8em;
	}

	.scope__detail {
		font-size: var(--s--1);
		line-height: 1.6;
		padding-left: 1.45rem;
	}

	@media (max-width: 56rem) {
		.scope {
			grid-template-columns: 1fr;
		}
	}
</style>
