---
import { getCollection } from 'astro:content';
import BrandMark from './BrandMark.astro';

const path = Astro.url.pathname;
// L'entree Blog n'apparait qu'a partir du premier article publie.
const blogOuvert = (await getCollection('blog', ({ data }) => !data.draft)).length > 0;
// Sur les pages interieures, les ancres doivent repartir de l'accueil.
const home = path === '/' ? '' : '/';

const links = [
	{ href: `${home}#expertises`, label: 'Expertises' },
	{ href: `${home}#methode`, label: 'Méthode' },
	{ href: '/guide/', label: 'Guide' },
	...(blogOuvert ? [{ href: '/blog/', label: 'Blog' }] : []),
	{ href: `${home}#faq`, label: 'FAQ' },
];
---

<header class="top" data-top>
	<div class="wrap top__in">
		<a class="logo" href="/" aria-label="Quoted, retour à l'accueil">
			Quoted<BrandMark class="logo__q" />
		</a>

		<nav class="menu" aria-label="Navigation principale">
			{
				links.map((link) => (
					<a href={link.href} aria-current={link.href === path ? 'page' : undefined}>
						{link.label}
					</a>
				))
			}
		</nav>

		<a class="b b--go top__cta" href="/scan/">Scanner ma visibilité IA</a>

		<button
			class="burger"
			type="button"
			aria-expanded="false"
			aria-controls="menu-mobile"
			data-burger
		>
			<span class="sr">Ouvrir le menu</span>
			<span aria-hidden="true"></span>
			<span aria-hidden="true"></span>
		</button>
	</div>

	<div class="tray" id="menu-mobile" hidden data-tray>
		{links.map((link) => <a href={link.href}>{link.label}</a>)}
		<a class="b b--go" href="/scan/">Scanner ma visibilité IA</a>
	</div>
</header>

<style>
	.top {
		position: sticky;
		top: 0;
		z-index: 50;
		background: color-mix(in srgb, var(--paper) 90%, transparent);
		backdrop-filter: blur(14px);
		border-bottom: 1px solid transparent;
		transition: border-color 0.2s ease;
	}

	.top[data-stuck] {
		border-bottom-color: var(--line);
	}

	.top__in {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		min-height: 4.75rem;
	}

	/* Mot-symbole suivi du guillemet fermant : le mot est « cité ». */
	.logo {
		display: inline-flex;
		align-items: flex-start;
		margin-right: auto;
		font-family: var(--display);
		font-size: 1.4rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: -0.03em;
		text-decoration: none;
	}

	.logo :global(.logo__q) {
		width: 0.46em;
		height: 0.46em;
		margin-left: 0.14em;
		margin-top: 0.08em;
		color: var(--accent);
		flex: none;
		transition: color 0.18s ease;
	}

	.logo:hover :global(.logo__q) {
		color: var(--dark);
	}

	.menu {
		display: flex;
		gap: 1.6rem;
	}

	.menu a {
		position: relative;
		font-family: var(--display);
		font-size: var(--s--1);
		font-weight: 600;
		color: var(--ink-soft);
		text-decoration: none;
		padding-block: 0.4rem;
		transition: color 0.16s ease;
	}

	.menu a::after {
		content: '';
		position: absolute;
		left: 0;
		bottom: 0;
		width: 100%;
		height: 2px;
		border-radius: 2px;
		background: var(--accent);
		transform: scaleX(0);
		transform-origin: right;
		transition: transform 0.24s cubic-bezier(0.2, 0.8, 0.3, 1);
	}

	.menu a:hover,
	.menu a[aria-current='page'] {
		color: var(--ink);
	}

	.menu a:hover::after,
	.menu a[aria-current='page']::after {
		transform: scaleX(1);
		transform-origin: left;
	}

	.burger {
		display: none;
		flex-direction: column;
		gap: 5px;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		background: transparent;
		border: 1px solid var(--line-strong);
		border-radius: 10px;
		cursor: pointer;
	}

	.burger span[aria-hidden] {
		width: 1.1rem;
		height: 2px;
		margin-inline: auto;
		background: var(--ink);
		border-radius: 2px;
		transition: transform 0.22s ease;
	}

	.burger[aria-expanded='true'] span[aria-hidden]:first-of-type {
		transform: translateY(3.5px) rotate(45deg);
	}

	.burger[aria-expanded='true'] span[aria-hidden]:last-of-type {
		transform: translateY(-3.5px) rotate(-45deg);
	}

	.tray {
		display: grid;
		gap: 0.25rem;
		padding: 0.75rem var(--gutter) 1.5rem;
		border-top: 1px solid var(--line);
	}

	.tray[hidden] {
		display: none;
	}

	.tray a:not(.b) {
		padding: 0.75rem 0;
		border-bottom: 1px solid var(--line);
		font-family: var(--display);
		font-size: 1.3rem;
		font-weight: 700;
		text-decoration: none;
	}

	.tray .b {
		margin-top: 1rem;
	}

	@media (max-width: 68rem) {
		.menu,
		.top__cta {
			display: none;
		}

		.burger {
			display: flex;
		}
	}
</style>

<script>
	const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
	const tray = document.querySelector<HTMLElement>('[data-tray]');
	const top = document.querySelector<HTMLElement>('[data-top]');

	if (burger && tray) {
		burger.addEventListener('click', () => {
			const open = burger.getAttribute('aria-expanded') === 'true';
			burger.setAttribute('aria-expanded', String(!open));
			tray.hidden = open;
		});

		tray.addEventListener('click', (event) => {
			if ((event.target as HTMLElement).closest('a')) {
				burger.setAttribute('aria-expanded', 'false');
				tray.hidden = true;
			}
		});
	}

	if (top) {
		const stick = () => {
			if (window.scrollY > 8) top.setAttribute('data-stuck', '');
			else top.removeAttribute('data-stuck');
		};
		stick();
		window.addEventListener('scroll', stick, { passive: true });
	}
</script>
