---
import { FAQ } from '../data/site';
---

<section class="section section--sunk" id="faq">
	<div class="shell">
		<div class="section-head reveal">
			<p class="eyebrow" data-num="07">Questions fréquentes</p>
			<h2>Ce qu'on nous demande <span class="accent">avant</span> de signer.</h2>
		</div>

		<div class="faq">
			{
				FAQ.map((item, index) => (
					<details class="qa reveal" style={`--delay: ${index * 50}ms`} name="faq">
						<summary>
							<span class="qa__q">{item.q}</span>
							<span class="qa__sign" aria-hidden="true" />
						</summary>
						<div class="qa__a">
							<p>{item.a}</p>
						</div>
					</details>
				))
			}
		</div>
	</div>
</section>

<style>
	.faq {
		border-top: 1px solid var(--line);
		max-width: 56rem;
	}

	.qa {
		border-bottom: 1px solid var(--line);
	}

	summary {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1.5rem;
		padding-block: 1.35rem;
		cursor: pointer;
		list-style: none;
		transition: color 0.18s ease;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	summary:hover {
		color: var(--violet);
	}

	.qa__q {
		font-family: var(--display);
		font-size: var(--step-1);
		line-height: 1.25;
		letter-spacing: -0.015em;
	}

	/* Croix qui pivote en moins a l'ouverture */
	.qa__sign {
		position: relative;
		flex: none;
		width: 1.1rem;
		height: 1.1rem;
		margin-top: 0.35rem;
	}

	.qa__sign::before,
	.qa__sign::after {
		content: '';
		position: absolute;
		inset: 50% 0 auto 0;
		height: 1.5px;
		background: var(--violet);
		transition: transform 0.28s cubic-bezier(0.2, 0.8, 0.3, 1);
	}

	.qa__sign::after {
		transform: rotate(90deg);
	}

	.qa[open] .qa__sign::after {
		transform: rotate(0deg);
	}

	.qa__a {
		padding-bottom: 1.5rem;
		max-width: var(--measure);
		animation: unfold 0.32s ease;
	}

	.qa__a p {
		font-size: var(--step--1);
		line-height: 1.7;
		color: var(--ink-soft);
	}

	@keyframes unfold {
		from {
			opacity: 0;
			transform: translateY(-4px);
		}
	}
</style>
