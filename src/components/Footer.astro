---
import { CONTACT_EMAIL } from '../data/site';

const year = 2026;
---

<footer class="foot">
	<div class="wrap foot__grid">
		<div class="foot__brand">
			<p class="foot__logo"><span aria-hidden="true">&rdquo;</span>Quoted</p>
			<p class="foot__line">
				Agence GEO. La visibilité de votre marque dans les réponses générées par
				ChatGPT, Perplexity, Gemini et les AI Overviews.
			</p>
			<a class="b b--lemon foot__cta" href={`mailto:${CONTACT_EMAIL}`}>
				{CONTACT_EMAIL}
			</a>
		</div>

		<nav class="foot__col" aria-label="Services">
			<h2>Services</h2>
			<ul>
				<li><a href="/#services">Cartographie de prompts</a></li>
				<li><a href="/#services">Audit de visibilité</a></li>
				<li><a href="/#services">Contenu conçu pour être cité</a></li>
				<li><a href="/#services">Présence hors site</a></li>
				<li><a href="/#outils">Nos outils</a></li>
			</ul>
		</nav>

		<nav class="foot__col" aria-label="En savoir plus">
			<h2>En savoir plus</h2>
			<ul>
				<li><a href="/guide/">Guide GEO</a></li>
				<li><a href="/#methode">Méthode</a></li>
				<li><a href="/#perimetre">Périmètre</a></li>
				<li><a href="/#clients">Clients accompagnés</a></li>
				<li><a href="/#faq">Questions fréquentes</a></li>
			</ul>
		</nav>
	</div>

	<div class="wrap foot__base">
		<p>&copy; {year} Quoted. Tous droits réservés.</p>
		<ul>
			<li><a href="/mentions-legales/">Mentions légales</a></li>
			<li><a href="/politique-de-confidentialite/">Politique de confidentialité</a></li>
		</ul>
	</div>
</footer>

<style>
	.foot {
		background: var(--navy);
		color: rgba(234, 240, 251, 0.72);
		padding-top: clamp(3rem, 6vw, 5rem);
		padding-bottom: 2rem;
		font-size: var(--s--1);
	}

	.foot__grid {
		display: grid;
		grid-template-columns: 1.6fr 1fr 1fr;
		gap: clamp(2rem, 4vw, 3.5rem);
		padding-bottom: clamp(2.5rem, 5vw, 3.5rem);
	}

	.foot__logo {
		font-family: var(--display);
		font-size: 1.7rem;
		font-weight: 700;
		letter-spacing: -0.04em;
		color: #fff;
		margin-bottom: 0.6rem;
	}

	.foot__logo span {
		color: var(--lemon);
		margin-right: 0.15rem;
	}

	.foot__line {
		max-width: 40ch;
		line-height: 1.6;
		margin-bottom: 1.4rem;
	}

	.foot__col h2 {
		font-family: var(--body);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: rgba(234, 240, 251, 0.45);
		margin-bottom: 1.1rem;
	}

	.foot__col ul {
		list-style: none;
		padding: 0;
		display: grid;
		gap: 0.6rem;
	}

	.foot a {
		color: inherit;
		text-decoration: none;
		transition: color 0.16s ease;
	}

	.foot__col a:hover,
	.foot__base a:hover {
		color: #fff;
	}

	.foot__base {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 2rem;
		justify-content: space-between;
		align-items: center;
		padding-top: 1.75rem;
		border-top: 1px solid rgba(234, 240, 251, 0.12);
		font-size: 0.8rem;
		color: rgba(234, 240, 251, 0.5);
	}

	.foot__base ul {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
		list-style: none;
		padding: 0;
	}

	@media (max-width: 58rem) {
		.foot__grid {
			grid-template-columns: repeat(2, 1fr);
		}

		.foot__brand {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 34rem) {
		.foot__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
