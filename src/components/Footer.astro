---
import { getCollection } from 'astro:content';
import BrandMark from './BrandMark.astro';
import { CONTACT_EMAIL } from '../data/site';

/**
 * Les colonnes metiers et secteurs sont alimentees par les collections :
 * elles restent a jour toutes seules quand une fiche est ajoutee.
 * L'ancienne colonne « Expertises » listait cinq libelles qui pointaient
 * tous vers la meme ancre, ce qui ne servait ni le lecteur ni le maillage.
 */
const parNom = (a, b) => a.data.nom.localeCompare(b.data.nom, 'fr');
const metiers = (await getCollection('metiers', ({ data }) => !data.draft)).sort(parNom);
const secteurs = (await getCollection('secteurs', ({ data }) => !data.draft)).sort(parNom);


const year = 2026;
---

<footer class="foot">
	<div class="wrap foot__grid">
		<div class="foot__brand">
			<p class="foot__logo">Quoted<BrandMark class="foot__mark" /></p>
			<p class="foot__line">
				Agence GEO. La visibilité de votre marque dans les réponses générées par
				ChatGPT, Perplexity, Gemini et les AI Overviews.
			</p>
			<a class="b b--go" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
		</div>

		<nav class="foot__col" aria-label="Référencement IA par métier">
			<h2><a href="/metiers/">Par métier</a></h2>
			<ul>
				{
					metiers.map((m) => (
						<li>
							<a href={`/metiers/${m.id}/`}>{m.data.nom}</a>
						</li>
					))
				}
			</ul>
		</nav>

		<nav class="foot__col" aria-label="Référencement IA par secteur">
			<h2><a href="/secteurs/">Par secteur</a></h2>
			<ul>
				{
					secteurs.map((x) => (
						<li>
							<a href={`/secteurs/${x.id}/`}>{x.data.nom}</a>
						</li>
					))
				}
			</ul>
		</nav>

		<nav class="foot__col" aria-label="En savoir plus">
			<h2>En savoir plus</h2>
			<ul>
				<li><a href="/#expertises">Nos expertises</a></li>
				<li><a href="/#methode">Méthode</a></li>
				<li><a href="/guide/">Guide GEO</a></li>
				<li><a href="/scan/">Scanner ma visibilité IA</a></li>
				<li><a href="/#faq">Questions fréquentes</a></li>
				<li><a href="/rss.xml">Flux RSS du guide</a></li>
			</ul>
		</nav>
	</div>

	<div class="wrap foot__base">
		<p>&copy; {year} Quoted. Tous droits réservés.</p>
		<ul>
			<li><a href="/mentions-legales/">Mentions légales</a></li>
			<li><a href="/politique-de-confidentialite/">Politique de confidentialité</a></li>
		</ul>
	</div>
</footer>

<style>
	.foot {
		background: var(--dark);
		color: rgba(238, 241, 247, 0.72);
		padding-top: clamp(3rem, 6vw, 5rem);
		padding-bottom: 2rem;
		font-size: var(--s--1);
	}

	.foot__grid {
		display: grid;
		grid-template-columns: 1.5fr repeat(3, minmax(0, 1fr));
		gap: clamp(2rem, 4vw, 3.5rem);
		padding-bottom: clamp(2.5rem, 5vw, 3.5rem);
	}

	.foot__logo {
		display: flex;
		align-items: flex-start;
		font-family: var(--display);
		font-size: 1.7rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: -0.03em;
		color: #fff;
		margin-bottom: 0.6rem;
	}

	.foot__logo :global(.foot__mark) {
		width: 0.46em;
		height: 0.46em;
		margin-left: 0.14em;
		margin-top: 0.08em;
		color: #fff;
		opacity: 0.55;
		flex: none;
	}

	.foot__line {
		max-width: 40ch;
		line-height: 1.6;
		margin-bottom: 1.4rem;
	}

	/* Les deux premieres colonnes ont un titre cliquable vers leur hub. */
	.foot__col h2 a {
		color: inherit;
	}

	.foot__col h2 a:hover {
		color: rgba(238, 241, 247, 0.8);
	}

	.foot__col h2 {
		font-family: var(--body);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: rgba(238, 241, 247, 0.45);
		margin-bottom: 1.1rem;
	}

	.foot__col ul {
		list-style: none;
		padding: 0;
		display: grid;
		gap: 0.6rem;
	}

	.foot a {
		color: inherit;
		text-decoration: none;
		transition: color 0.16s ease;
	}

	.foot__col a:hover,
	.foot__base a:hover {
		color: #fff;
	}

	.foot__base {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 2rem;
		justify-content: space-between;
		align-items: center;
		padding-top: 1.75rem;
		border-top: 1px solid rgba(238, 241, 247, 0.12);
		font-size: 0.8rem;
		color: rgba(238, 241, 247, 0.5);
	}

	.foot__base ul {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
		list-style: none;
		padding: 0;
	}

	@media (max-width: 68rem) {
		.foot__grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		.foot__brand {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 52rem) {
		.foot__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.foot__brand {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 34rem) {
		.foot__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
