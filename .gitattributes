# Normalisation des fins de ligne : LF dans le depot, quelle que soit la
# plateforme de travail. Evite que des octets CRLF se retrouvent commites.
* text=auto eol=lf

# Binaires : jamais de conversion
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.woff binary
*.woff2 binary
*.ico binary
